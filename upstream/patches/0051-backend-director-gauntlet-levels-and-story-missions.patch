+import { GetUnitOfWork, GetRepositories } from "./persistence";
 import { GetMongoDb } from "./persistence/mongo/client";
 
 export const GAUNTLET_COLLECTION = "gauntletProgress";
@@ -41,9 +42,35 @@ export function RequestedGauntletLevel(value: unknown): number | undefined {
     // Native FGauntletLevel numbers include the season: Season01 level 1 = 10000001.
     if (parsed >= 10000000) return parsed > 10000000 && parsed < 20000000 ? parsed - 10000000 : undefined;
     return parsed;
+
 }
 
 export function GauntletNativeLevel(level: number): number {
     if (!Number.isSafeInteger(level) || level < 1 || level >= 10000000) throw new Error("Invalid Gauntlet level");
     return 10000000 + level;
 }
+
+// Native 1.14.7 DefaultGame.ini names POST /process_run. Its success serializer
+// (FGauntletLevelSuccessData) sends gauntlet_id, players, level, remaining_sec.
+export async function RecordGauntletSuccess(body: any): Promise<number> {
+    const Level=RequestedGauntletLevel(body?.level);
+    const Players=Array.isArray(body?.players)?[...new Set<string>(body.players.filter((Id:unknown)=>typeof Id==="string" && Id!=="INVALID" && Id!==""))]:[];
+    if(body?.gauntlet_id!==GAUNTLET_SEASON_ID || !Level || Level>100000 || !Players.length || Players.length>4
+        || !Number.isSafeInteger(body?.remaining_sec) || body.remaining_sec<0 || body.remaining_sec>86400)
+        throw new Error("INVALID_GAUNTLET_RESULT");
+    for(const Player of Players) if(!await GetRepositories().accounts.findByUserId(Player)) throw new Error("INVALID_GAUNTLET_PLAYER");
+    return GetUnitOfWork().withTransaction(async(_Repos,Session)=>{
+        const Db=await GetMongoDb();let Changed=0;
+        for(const Player of Players) {
+            const Id=`${GAUNTLET_SEASON_ID}:${Player}`;
+            const Row=await Db.collection(GAUNTLET_COLLECTION).findOne({_id:Id as any},{session:Session});
+            const Completed=CompletedGauntletLevel(Row?.completedLevel);
+            if(Level>Completed+1) throw new Error("GAUNTLET_LEVEL_LOCKED");
+            if(Level<=Completed) continue;
+            await Db.collection(GAUNTLET_COLLECTION).updateOne({_id:Id as any},
+                {$max:{completedLevel:Level},$set:{userId:Player,season:GAUNTLET_SEASON_ID,updatedAt:new Date().toISOString()},
+                 $setOnInsert:{createdAt:new Date().toISOString()}},{upsert:true,session:Session});Changed++;
+        }
+        return Changed;
+    });
+}
