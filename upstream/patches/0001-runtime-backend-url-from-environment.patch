+// ============================================================================
+// [Dauntless Reforged Revival] Backend endpoint chosen at run time.
+//
+// The launcher sets REFORGED_BACKEND_URL for the game client (its local relay, for example
+// http://127.0.0.1:61100), and the deploy server's environment sets it for the dedicated game
+// servers it starts (the backend on the same machine, for example http://127.0.0.1:61000). The
+// relay carries the client's traffic to the chosen server over TLS pinned to the server's
+// certificate, so nothing about a host has to be compiled into the runtime. Without the variable
+// the compiled-in MP_PUBLIC_HOST is used over https, exactly as before.
+//
+// Accepted: http:// or https://, a host of [A-Za-z0-9.-], an optional :port and nothing else
+// (no credentials, path, query or fragment). Any other value is ignored and logged once.
+// ============================================================================
+struct MpBackendEndpoint {
+    std::wstring Base;           // scheme://host[:port], no trailing slash
+    std::wstring Host;           // host only
+    int Port = 443;
+    bool Secure = true;
+    bool FromEnvironment = false;
+    bool RejectedEnvironment = false;
+};
+
+static bool MpIsBackendHostChar(wchar_t C) {
+    return (C >= L'a' && C <= L'z') || (C >= L'A' && C <= L'Z') || (C >= L'0' && C <= L'9') || C == L'.' || C == L'-';
+}
+
+static bool MpParseBackendUrl(const std::wstring& Url, MpBackendEndpoint& Out) {
+    std::wstring Rest;
+    bool Secure = false;
+    if (Url.size() > 7 && _wcsnicmp(Url.c_str(), L"http://", 7) == 0) { Rest = Url.substr(7); Secure = false; }
+    else if (Url.size() > 8 && _wcsnicmp(Url.c_str(), L"https://", 8) == 0) { Rest = Url.substr(8); Secure = true; }
+    else return false;
+    if (Rest.empty() || Rest.size() > 255) return false;
+
+    std::wstring Host = Rest;
+    int Port = Secure ? 443 : 80;
+    const size_t Colon = Rest.find(L':');
+    if (Colon != std::wstring::npos) {
+        Host = Rest.substr(0, Colon);
+        const std::wstring PortText = Rest.substr(Colon + 1);
+        if (PortText.empty() || PortText.size() > 5) return false;
+        int Value = 0;
+        for (wchar_t C : PortText) {
+            if (C < L'0' || C > L'9') return false;
+            Value = Value * 10 + static_cast<int>(C - L'0');
+        }
+        if (Value < 1 || Value > 65535) return false;
+        Port = Value;
+    }
+    if (Host.empty() || Host.front() == L'.' || Host.front() == L'-' || Host.back() == L'.' || Host.back() == L'-') return false;
+    for (wchar_t C : Host) {
+        if (!MpIsBackendHostChar(C)) return false;
+    }
+
+    Out.Host = Host;
+    Out.Port = Port;
+    Out.Secure = Secure;
+    Out.Base = std::wstring(Secure ? L"https://" : L"http://") + Host;
+    if (Colon != std::wstring::npos) Out.Base += L":" + std::to_wstring(Port);
+    return true;
+}
+
+static const MpBackendEndpoint& MpBackend() {
+    static const MpBackendEndpoint Endpoint = [] {
+        MpBackendEndpoint Result;
+        wchar_t Buffer[300]{};
+        const DWORD Length = GetEnvironmentVariableW(L"REFORGED_BACKEND_URL", Buffer, static_cast<DWORD>(std::size(Buffer)));
+        if (Length > 0 && Length < std::size(Buffer)) {
+            if (MpParseBackendUrl(std::wstring(Buffer, Length), Result)) {
+                Result.FromEnvironment = true;
+                return Result;
+            }
+            Result = MpBackendEndpoint{};
+            Result.RejectedEnvironment = true;
+        }
+        Result.Base = L"https://" MP_PUBLIC_HOST;
+        Result.Host = MP_PUBLIC_HOST;
+        Result.Port = 443;
+        Result.Secure = true;
+        return Result;
+    }();
+    return Endpoint;
+}
+
+static void MpLogBackendEndpointOnce(const char* Mode) {
+    static volatile LONG Logged = 0;
+    if (InterlockedExchange(&Logged, 1) != 0) return;
+    const MpBackendEndpoint& Endpoint = MpBackend();
+    MpLog(std::string("[Reforged] (") + Mode + ") backend " + MpNarrow(Endpoint.Base)
+        + (Endpoint.FromEnvironment ? " from REFORGED_BACKEND_URL"
+            : (Endpoint.RejectedEnvironment ? " (REFORGED_BACKEND_URL was not a plain http(s)://host[:port] URL and was ignored)"
+                : " (compiled-in MP_PUBLIC_HOST)")));
+}
 
