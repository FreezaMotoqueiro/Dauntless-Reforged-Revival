+// Native 1.14.7 Discipline exists even though this captured rotation omitted it.
+const Discipline = Catalog.get("PR_DISCIPLINE");
+if (Discipline && !Store.some(Sku => Sku.items.some(Item => Item.catalogId === "PR_DISCIPLINE"))) {
+    Store.push({
+        id: "trials_pr_discipline", displayName: "Discipline",
