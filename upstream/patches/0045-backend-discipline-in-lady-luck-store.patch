+        tags: ["ladyluckstore", "store_trials_tab_cells"],
+        items: [{ catalogId: "PR_DISCIPLINE", quantity: 1, instanced: true }],
+        duplicateInstancedItems: ["PR_DISCIPLINE"]
+    });
+}
+
