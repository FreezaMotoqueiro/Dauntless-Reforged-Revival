+// [CLIENT HUD 2026-10-16] Behemoth health bars. Client only and RVA-free: drawn with the HUD's own reflected
+// Canvas functions (HUD.DrawRect / DrawText / DrawTexture / GetTextSize) while the HUD draws its frame, which is
+// the only moment AHUD::Canvas is valid. Nothing is created, so there is no widget lifetime to manage.
+//   - A behemoth gets a bar only after the local player damages it: BP_PlayerCharacter_C.LastDamagedActor
+//     (SDK/BP_PlayerCharacter_classes.hpp) points at it. A second damaged behemoth gets the second bar.
+//   - Health and shield come from the behemoth's UArchonHealthAttributeSet (CurrentHealth, MaxHealth,
+//     CurrentShield; replicated). There is no MaxShield, so the shield bar is relative to the largest shield
+//     seen since the shield last came up.
+//   - The icon is UBehemothMarkerComponent.BehemothIcon, the texture the map marker uses.
+//   - Layout (fractions of the canvas, right side under the danger meter):
+//         [icon] [==== HP bar  "cur / max" ====]
+//                [== shield bar "cur / max" ==]     only while the shield is up
+//         [icon] [==== HP bar of a 2nd behemoth ====]
+//   - A dead behemoth's bar stays 3 s, then goes.
+// The attribute set and marker are found once per behemoth by a GObjects walk (objects whose Outer is the actor).
+// DISABLE_BEHEMOTH_BARS.flag beside the executable turns the bars off.
+namespace BehemothBars {
+
+constexpr float kBarLeft = 0.884f;               // fractions of the canvas
+constexpr float kBarWidth = 0.106f;
+constexpr float kSlotTop[2] = { 0.3635f, 0.4265f };
+constexpr float kBarH = 22.0f;                   // pixels at 1080p, scaled with the canvas height
+constexpr float kShieldH = 15.0f;
+constexpr float kShieldGap = 4.0f;
+constexpr float kIconSize = 34.0f;
+constexpr float kRingSize = 40.0f;
+constexpr float kIconGap = 8.0f;
+constexpr uint64_t kDeadHideMs = 3000;
+
+struct Entry {
+    SDK::AActor* Actor = nullptr;
+    SDK::UArchonHealthAttributeSet* Health = nullptr;
+    SDK::UBehemothMarkerComponent* Marker = nullptr;
+    float ShieldPeak = 0.0f;
+    uint64_t DeadAtMs = 0;
+    uint64_t LastHitMs = 0;
+};
+
+static std::vector<Entry> s_Entries;
+static uint64_t s_LastDrawMs = 0;
+static int s_DrawsSeen = 0;
+
+static bool Live(const void* Ptr) {
+    return Ptr && IsReadablePointer(Ptr, 0x60) && IsRegisteredLiveObject(Ptr);
+}
+
+static void FindParts(Entry& E) {
+    E.Health = nullptr;
+    E.Marker = nullptr;
+    const int Count = SDK::UObject::GObjects->Num();
+    for (int i = 0; i < Count && !(E.Health && E.Marker); i++) {
+        SDK::UObject* Obj = SDK::UObject::GObjects->GetByIndex(i);
+        if (!Obj || Obj->IsDefaultObject()) continue;
+        // Components are outered to the actor; an attribute set may sit one level down (its ability component).
+        SDK::UObject* Outer = Obj->Outer;
+        const SDK::UObject* Owner = static_cast<SDK::UObject*>(E.Actor);
+        if (Outer != Owner && !(Outer && Outer->Outer == Owner)) continue;
+        if (!E.Health && Obj->IsA(SDK::UArchonHealthAttributeSet::StaticClass())) {
+            E.Health = static_cast<SDK::UArchonHealthAttributeSet*>(Obj);
+        } else if (!E.Marker && Obj->IsA(SDK::UBehemothMarkerComponent::StaticClass())) {
+            E.Marker = static_cast<SDK::UBehemothMarkerComponent*>(Obj);
+        }
+    }
+    MpLog("[BehemothBars] engaged " + E.Actor->GetName() + " health=" + MpPtr(E.Health)
+        + " marker=" + MpPtr(E.Marker));
+}
+
+static bool ReadHealth(Entry& E, float& Cur, float& Max, float& Shield) {
+    if (!Live(E.Health)) {
+        // No attribute set found: the behemoth's own getters still give health (no shield then).
+        auto* Behemoth = static_cast<SDK::AArchonBehemoth*>(E.Actor);
+        Cur = Behemoth->GetCurrentHealth();
+        Max = Behemoth->GetMaxHealth();
+        Shield = 0.0f;
+        return Max > 0.0f;
+    }
+    Cur = E.Health->CurrentHealth;
+    Max = E.Health->MaxHealth;
+    Shield = E.Health->CurrentShield;
+    return Max > 0.0f;
+}
+
+// The local player's last damaged actor, when it is a behemoth.
+static SDK::AActor* LastDamagedBehemoth(SDK::AHUD* Hud) {
+    SDK::APlayerController* PC = Hud->PlayerOwner;
+    if (!Live(PC)) return nullptr;
+    SDK::APawn* Pawn = PC->Pawn;
+    if (!Live(Pawn) || !Pawn->IsA(SDK::ABP_PlayerCharacter_C::StaticClass())) return nullptr;
+    SDK::AActor* Target = static_cast<SDK::ABP_PlayerCharacter_C*>(Pawn)->LastDamagedActor;
+    if (!Live(Target) || !Target->IsA(SDK::AArchonBehemoth::StaticClass())) return nullptr;
+    return Target;
+}
+
+static void UpdateEntries(SDK::AHUD* Hud, uint64_t Now) {
+    // Drop behemoths that are gone (map change, despawn) or dead for long enough.
+    std::erase_if(s_Entries, [Now](const Entry& E) {
+        return !Live(E.Actor) || (E.DeadAtMs && Now - E.DeadAtMs > kDeadHideMs);
+    });
+
+    SDK::AActor* Target = LastDamagedBehemoth(Hud);
+    if (!Target) return;
+    for (Entry& E : s_Entries) {
+        if (E.Actor == Target) { E.LastHitMs = Now; return; }
+    }
+    Entry New;
+    New.Actor = Target;
+    New.LastHitMs = Now;
+    FindParts(New);
+    if (s_Entries.size() < 2) {
+        s_Entries.push_back(New);
+    } else {
+        // A third behemoth replaces the one hit longest ago.
+        Entry& Oldest = s_Entries[0].LastHitMs <= s_Entries[1].LastHitMs ? s_Entries[0] : s_Entries[1];
+        Oldest = New;
+    }
+}
+
+// ---- drawing: reflected AHUD functions (Params structs from SDK/Engine_parameters.hpp)
+
+static SDK::UFunction* HudFn(SDK::AHUD* Hud, const char* Name) {
+    SDK::UFunction* Fn = Hud->Class ? Hud->Class->GetFunction("HUD", Name) : nullptr;
+    if (!Fn) MpLog(std::string("[BehemothBars] HUD.") + Name + " not found");
+    return Fn;
+}
+
+struct Painter {
+    SDK::AHUD* Hud;
+    SDK::UFont* Font;
+    SDK::UFunction* RectFn;
+    SDK::UFunction* TextFn;
+    SDK::UFunction* TextureFn;
+    SDK::UFunction* TextSizeFn;
+
+    void Rect(const SDK::FLinearColor& Color, float X, float Y, float W, float H) const {
+        Params::HUD_DrawRect P{};
+        P.RectColor = Color;
+        P.ScreenX = X; P.ScreenY = Y; P.ScreenW = W; P.ScreenH = H;
+        Hud->ProcessEvent(RectFn, &P);
+    }
+
+    void Texture(SDK::UTexture* Tex, float X, float Y, float W, float H, const SDK::FLinearColor& Tint) const {
+        if (!Tex || !TextureFn) return;
+        Params::HUD_DrawTexture P{};
+        P.Texture = Tex;
+        P.ScreenX = X; P.ScreenY = Y; P.ScreenW = W; P.ScreenH = H;
+        P.TextureU = 0.0f; P.TextureV = 0.0f; P.TextureUWidth = 1.0f; P.TextureVHeight = 1.0f;
+        P.TintColor = Tint;
+        P.BlendMode = SDK::EBlendMode::BLEND_Translucent;
+        P.Scale = 1.0f;
+        P.bScalePosition = false;
+        P.Rotation = 0.0f;
+        P.RotPivot.X = 0.5f; P.RotPivot.Y = 0.5f;
+        Hud->ProcessEvent(TextureFn, &P);
+    }
+
+    // Text centred in the box, with a 1 px shadow; shrunk to fit the box height.
+    void CenteredText(const std::wstring& Text, float X, float Y, float W, float H) const {
+        if (!Font || !TextFn || !TextSizeFn) return;
+        Params::HUD_GetTextSize Size{};
+        Size.Text = SDK::FString(Text.c_str());
+        Size.Font = Font;
+        Size.Scale = 1.0f;
+        Hud->ProcessEvent(TextSizeFn, &Size);
+        if (Size.OutHeight <= 0.0f || Size.OutWidth <= 0.0f) return;
+        const float Scale = (std::min)((H * 0.9f) / Size.OutHeight, (W - 6.0f) / Size.OutWidth);
+        const float TX = X + (W - Size.OutWidth * Scale) * 0.5f;
+        const float TY = Y + (H - Size.OutHeight * Scale) * 0.5f;
+        for (int Pass = 0; Pass < 2; Pass++) {
+            Params::HUD_DrawText P{};
+            P.Text = SDK::FString(Text.c_str());
+            P.TextColor = Pass == 0 ? SDK::FLinearColor{ 0.0f, 0.0f, 0.0f, 0.85f } : SDK::FLinearColor{ 1.0f, 1.0f, 1.0f, 1.0f };
+            P.ScreenX = TX + (Pass == 0 ? 1.0f : 0.0f);
+            P.ScreenY = TY + (Pass == 0 ? 1.0f : 0.0f);
+            P.Font = Font;
+            P.Scale = Scale;
+            P.bScalePosition = false;
+            Hud->ProcessEvent(TextFn, &P);
+        }
+    }
+};
+
+static std::wstring Thousands(float Value) {
+    long long N = static_cast<long long>((std::max)(0.0f, std::ceil(Value)));
+    std::wstring Digits = std::to_wstring(N);
+    std::wstring Out;
+    int Count = 0;
+    for (auto It = Digits.rbegin(); It != Digits.rend(); ++It) {
+        if (Count && Count % 3 == 0) Out.insert(Out.begin(), L',');
+        Out.insert(Out.begin(), *It);
+        Count++;
+    }
+    return Out;
+}
+
+static void Bar(const Painter& P, float X, float Y, float W, float H, float Fraction,
+                const SDK::FLinearColor& Fill, const std::wstring& Text) {
+    Fraction = std::clamp(Fraction, 0.0f, 1.0f);
+    P.Rect({ 0.0f, 0.0f, 0.0f, 0.75f }, X - 1.0f, Y - 1.0f, W + 2.0f, H + 2.0f);          // frame
+    P.Rect({ 0.08f, 0.08f, 0.08f, 0.85f }, X, Y, W, H);                                  // track
+    if (Fraction > 0.0f) {
+        P.Rect(Fill, X, Y, W * Fraction, H);
+        P.Rect({ 1.0f, 1.0f, 1.0f, 0.12f }, X, Y, W * Fraction, H * 0.35f);              // top sheen
+    }
+    P.CenteredText(Text, X, Y, W, H);
+}
+
+static SDK::UTexture2D* RingTexture() {
+    static SDK::UTexture2D* s_Ring = nullptr;
+    static bool s_Looked = false;
+    if (s_Ring && Live(s_Ring)) return s_Ring;
+    if (s_Looked) return nullptr;
+    s_Looked = true;
+    const int Count = SDK::UObject::GObjects->Num();
+    for (int i = 0; i < Count; i++) {
+        SDK::UObject* Obj = SDK::UObject::GObjects->GetByIndex(i);
+        if (!Obj || !Obj->IsA(SDK::UTexture2D::StaticClass())) continue;
+        if (Obj->GetName() == "WhiteRing") { s_Ring = static_cast<SDK::UTexture2D*>(Obj); break; }
+    }
+    MpLog("[BehemothBars] ring texture " + std::string(s_Ring ? "found" : "not found (icon drawn without ring)"));
+    return s_Ring;
+}
+
+static void OnDrawHUD(SDK::UObject* Object, void* Parms) {
+    if (Globals::AmServer) return;                                   // client only
+    static const bool s_Disabled = MpExeRelativeFlagPresent(L"DISABLE_BEHEMOTH_BARS.flag");
+    if (s_Disabled) return;
+    if (!Object || !Parms || !IsReadablePointer(Object, sizeof(SDK::AHUD))) return;
+    if (!Object->IsA(SDK::AHUD::StaticClass())) return;
+    auto* Hud = static_cast<SDK::AHUD*>(Object);
+    if (!Hud->Canvas || !IsReadablePointer(Hud->Canvas, 0x40)) return;
+
+    const auto* Size = static_cast<const Params::HUD_ReceiveDrawHUD*>(Parms);
+    const float SizeX = static_cast<float>(Size->SizeX);
+    const float SizeY = static_cast<float>(Size->SizeY);
+    const uint64_t Now = GetTickCount64();
+    s_LastDrawMs = Now;
+    if (s_DrawsSeen++ == 0) {
+        MpLog("[BehemothBars] HUD draws: " + Hud->Class->GetName() + " canvas=" + std::to_string(Size->SizeX)
+            + "x" + std::to_string(Size->SizeY));
+    }
+    if (SizeX < 320.0f || SizeY < 240.0f) return;
+
+    UpdateEntries(Hud, Now);
+    if (s_Entries.empty()) return;
+
+    static SDK::UFunction* s_Rect = HudFn(Hud, "DrawRect");
+    static SDK::UFunction* s_Text = HudFn(Hud, "DrawText");
+    static SDK::UFunction* s_Texture = HudFn(Hud, "DrawTexture");
+    static SDK::UFunction* s_TextSize = HudFn(Hud, "GetTextSize");
+    if (!s_Rect) return;
+    SDK::UEngine* Engine = SDK::UEngine::GetEngine();
+    Painter P{ Hud, Engine ? Engine->MediumFont : nullptr, s_Rect, s_Text, s_Texture, s_TextSize };
+
+    const float S = SizeY / 1080.0f;
+    const float Left = std::floor(SizeX * kBarLeft);
+    const float Width = std::floor(SizeX * kBarWidth);
+    const float BarH = std::round(kBarH * S);
+    const float ShieldH = std::round(kShieldH * S);
+
+    for (size_t Slot = 0; Slot < s_Entries.size() && Slot < 2; Slot++) {
+        Entry& E = s_Entries[Slot];
+        float Cur = 0.0f, Max = 0.0f, Shield = 0.0f;
+        if (!ReadHealth(E, Cur, Max, Shield)) continue;
+        if (Cur <= 0.0f && !E.DeadAtMs) E.DeadAtMs = Now;
+        if (Cur > 0.0f) E.DeadAtMs = 0;
+
+        const float Top = std::floor(SizeY * kSlotTop[Slot]);
+        Bar(P, Left, Top, Width, BarH, Cur / Max, { 0.78f, 0.09f, 0.07f, 0.95f },
+            Thousands(Cur) + L" / " + Thousands(Max));
+
+        if (Shield > 0.0f) {
+            E.ShieldPeak = (std::max)(E.ShieldPeak, Shield);
+            Bar(P, Left, Top + BarH + std::round(kShieldGap * S), Width, ShieldH, Shield / E.ShieldPeak,
+                { 0.18f, 0.52f, 1.0f, 0.95f }, Thousands(Shield) + L" / " + Thousands(E.ShieldPeak));
+        } else {
+            E.ShieldPeak = 0.0f;
+        }
+
+        // Icon in a ring, left of the bar, centred on the HP bar.
+        const float CX = Left - std::round(kIconGap * S) - kRingSize * S * 0.5f;
+        const float CY = Top + BarH * 0.5f;
+        if (SDK::UTexture2D* Ring = RingTexture()) {
+            const float R = kRingSize * S;
+            P.Texture(Ring, CX - R * 0.5f, CY - R * 0.5f, R, R, { 0.85f, 0.68f, 0.32f, 1.0f });
+        }
+        SDK::UTexture2D* Icon = Live(E.Marker) ? E.Marker->BehemothIcon : nullptr;
+        if (Live(Icon)) {
+            const float I = kIconSize * S;
+            P.Texture(Icon, CX - I * 0.5f, CY - I * 0.5f, I, I, { 1.0f, 1.0f, 1.0f, 1.0f });
+        }
+    }
+}
+
+// Called about every 2 s from the client ProcessEvent hook: says once whether the HUD draws at all, so a
+// missing bar can be told apart from a HUD that never calls ReceiveDrawHUD.
+static void Watch() {
+    static bool s_Reported = false;
+    static uint64_t s_FirstHudMs = 0;
+    if (s_Reported || Globals::AmServer) return;
+    SDK::UWorld* World = SDK::UWorld::GetWorld();
+    if (!Live(World) || !Live(World->OwningGameInstance)) return;
+    auto& Players = World->OwningGameInstance->LocalPlayers;
+    if (Players.Num() < 1 || !Live(Players[0]) || !Live(Players[0]->PlayerController)) return;
+    SDK::AHUD* Hud = Players[0]->PlayerController->MyHUD;
+    if (!Live(Hud)) return;
+    const uint64_t Now = GetTickCount64();
+    if (!s_FirstHudMs) s_FirstHudMs = Now;
+    if (s_DrawsSeen > 0) { s_Reported = true; return; }
+    if (Now - s_FirstHudMs < 15000) return;
+    s_Reported = true;
+    MpLog("[BehemothBars] HUD " + Hud->Class->GetName() + " exists but ReceiveDrawHUD was not seen in 15 s; bShowHUD="
+        + std::to_string(static_cast<int>(Hud->bShowHUD)) + " - bars cannot draw");
+}
