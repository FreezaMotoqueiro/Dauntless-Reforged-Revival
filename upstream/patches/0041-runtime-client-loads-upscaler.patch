+// [Reforged 0041] Optional upscaler for the player client (DLSS / FSR on DirectX 11).
+// The Luma Framework's Unreal Engine mod (github.com/Filoppi/Luma-Framework) replaces the game's TAA pass
+// with DLSS or FSR 3.1. It is a ReShade add-on, and ReShade normally loads as a proxy dxgi.dll. A proxy would
+// also load into every game server started from the same folder (the Director runs this same executable),
+// so the files are installed with ReShade renamed to ReShade64.dll, which nothing loads on its own, and the
+// runtime loads it here, on the client only, before the engine creates its D3D11 device. ReShade then finds
+// the add-on and its shaders beside itself. The server role (-server) and -nullrhi never load it.
+// DISABLE_UPSCALER.flag beside the game executable turns it off without uninstalling.
+static void MpLoadClientUpscaler() {
+    if (Globals::AmServer) return;
+    if (MpOsCommandLineHas(L"-nullrhi")) return;
+    if (!MpExeRelativeFlagPresent(L"ReShade64.dll")) return;
+    if (MpExeRelativeFlagPresent(L"DISABLE_UPSCALER.flag")) {
+        InitLog("[Upscaler] ReShade64.dll present, DISABLE_UPSCALER.flag set: not loaded");
+        return;
+    }
+    wchar_t Path[MAX_PATH];
+    const size_t DirLen = MpExeDirFromModuleW(Path);
+    static const wchar_t kName[] = L"ReShade64.dll";
+    const size_t NameLen = (sizeof(kName) / sizeof(kName[0])) - 1;
+    if (DirLen == 0 || DirLen + NameLen + 1 > MAX_PATH) return;
+    for (size_t i = 0; i <= NameLen; ++i) Path[DirLen + i] = kName[i];
+    HMODULE Module = LoadLibraryW(Path);
+    InitLog(std::string("[Upscaler] ReShade64.dll ") + (Module ? "loaded" : ("failed error=" + std::to_string(GetLastError()))));
+}
+
 void Init() {
     InitLog("[Init] Entry");
     // [2026-10-10 1.14.7 CPU] Resolve the exe directory for the flag-file cache once and decide the cache mode
@@ -22802,6 +22828,7 @@ void Init() {
         Globals::EnableLogging = true;
 
         InitClientHooks();
+        MpLoadClientUpscaler();
     }
 
     InitLog("[Init] About to create MainThread...");
