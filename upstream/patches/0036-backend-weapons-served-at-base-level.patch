diff --git a/ParadoxBackend/src/weaponBaseLevel.test.ts b/ParadoxBackend/src/weaponBaseLevel.test.ts
new file mode 100644
index 0000000..51cf215
--- /dev/null
+++ b/ParadoxBackend/src/weaponBaseLevel.test.ts
@@ -0,0 +1,68 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { ServeWeaponsAtBaseLevel, WeaponItemDataAtBaseLevel } from "./weaponBaseLevel";
+
+const Levelled = JSON.stringify({ TransmogCatalogID: "None", UnlockedAsTransmog: false, CurrentLevel: 5, DataVersion: 1, EquippedCells: [], EquippedWeaponParts: [], CurrentXP: 0 });
+
+function WithEnv(Value: string | undefined, Run: () => void) {
+    const Before = process.env.KEEP_WEAPON_ITEM_LEVELS;
+    if (Value === undefined) delete process.env.KEEP_WEAPON_ITEM_LEVELS;
+    else process.env.KEEP_WEAPON_ITEM_LEVELS = Value;
+    try { Run(); } finally {
+        if (Before === undefined) delete process.env.KEEP_WEAPON_ITEM_LEVELS;
+        else process.env.KEEP_WEAPON_ITEM_LEVELS = Before;
+    }
+}
+
+test("a levelled weapon is served at level 0 with the rest of its data kept", () => {
+    const Out = JSON.parse(WeaponItemDataAtBaseLevel("WP_MS_MCROLLIN", Levelled) as string);
+    assert.equal(Out.CurrentLevel, 0);
+    assert.equal(Out.DataVersion, 1);
+    assert.deepEqual(Out.EquippedWeaponParts, []);
+});
+
+test("level 0, missing level, other items and bad data are unchanged", () => {
+    const Zero = JSON.stringify({ CurrentLevel: 0 });
+    assert.equal(WeaponItemDataAtBaseLevel("WP_MS_MCROLLIN", Zero), Zero);
+    assert.equal(WeaponItemDataAtBaseLevel("WP_MS_BEGINNER", null), null);
+    assert.equal(WeaponItemDataAtBaseLevel("AR_ROCK_HELM", JSON.stringify({ CurrentLevel: 5 })), JSON.stringify({ CurrentLevel: 5 }));
+    assert.equal(WeaponItemDataAtBaseLevel("WP_CB_MCROLLIN", "{CurrentLevel"), "{CurrentLevel");
+});
+
+test("an inventory response is copied with its weapons at level 0", () => {
+    WithEnv(undefined, () => {
+        const Inventory = {
+            characterId: "c",
+            instancedItems: [
+                { catalogId: "WP_CB_MCROLLIN", instanceId: "WP_CB_MCROLLIN", itemData: Levelled, updateVersion: 5 },
+                { catalogId: "LT_BASIC", instanceId: "x", itemData: null as string | null, updateVersion: 0 },
+            ],
+            stackedItems: [{ catalogId: "CURRENCY_NOTES", quantity: 3 }],
+        };
+        const Out = ServeWeaponsAtBaseLevel(Inventory);
+        assert.notEqual(Out, Inventory);
+        assert.equal(JSON.parse(String(Out.instancedItems[0].itemData)).CurrentLevel, 0);
+        assert.equal(Out.instancedItems[0].updateVersion, 5);
+        assert.equal(Out.instancedItems[1], Inventory.instancedItems[1]);
+        assert.equal(Out.stackedItems, Inventory.stackedItems);
+        assert.equal(JSON.parse(String(Inventory.instancedItems[0].itemData)).CurrentLevel, 5, "the stored object is not mutated");
+    });
+});
+
+test("a single item and a nested transaction result are handled", () => {
+    WithEnv(undefined, () => {
+        const Item = { catalogId: "WP_MS_FULGAR", instanceId: "i", itemData: Levelled, updateVersion: 2 };
+        assert.equal(JSON.parse(ServeWeaponsAtBaseLevel(Item).itemData).CurrentLevel, 0);
+        const Result = { payload: { instancedItemsAdded: [Item] } };
+        assert.equal(JSON.parse(ServeWeaponsAtBaseLevel(Result).payload.instancedItemsAdded[0].itemData).CurrentLevel, 0);
+        const Plain = { a: 1, b: [1, 2] };
+        assert.equal(ServeWeaponsAtBaseLevel(Plain), Plain);
+    });
+});
+
+test("KEEP_WEAPON_ITEM_LEVELS=true serves the stored level", () => {
+    WithEnv("true", () => {
+        const Item = { catalogId: "WP_MS_FULGAR", instanceId: "i", itemData: Levelled, updateVersion: 2 };
+        assert.equal(ServeWeaponsAtBaseLevel(Item), Item);
+    });
+});
diff --git a/ParadoxBackend/src/weaponBaseLevel.ts b/ParadoxBackend/src/weaponBaseLevel.ts
new file mode 100644
index 0000000..e3ed71b
--- /dev/null
+++ b/ParadoxBackend/src/weaponBaseLevel.ts
@@ -0,0 +1,61 @@
+// [Dauntless Reforged Revival 0036] Weapons are served at item level 0.
+//
+// A weapon's itemData carries CurrentLevel (EUpgradeableItemLevel). The game picks the weapon's power
+// table for that level (UArchonGlobalTuning::GetWeaponPowerTable(ItemLevel), from
+// WeaponPowerTablePerLevels). The 1.14.7 paks only carry the base weapon_power_table (plus
+// weapon_power_table_level_01 and an obprog one), so any weapon with CurrentLevel above 0 gets no table:
+// the game server logs "Weapon: invalid weapon power table reference on (<weapon>_bp_C)" and every
+// value read from the table is 0. Those values include CBlade_MeterGainScale, MSpear_MeterGainScale,
+// MSpear_MeterGainPerX/YAttack and the War Pike damage multipliers, so on such a weapon the special
+// meter never fills and the War Pike stops wounding (seen on the VPS 2026-10-23 with WP_MS_MCROLLIN and
+// WP_CB_MCROLLIN at CurrentLevel 5; level-0 weapons never log the warning).
+//
+// The stored level is left as it is; only what the game reads is set to 0, so the base table is used.
+// KEEP_WEAPON_ITEM_LEVELS=true serves the stored levels again.
+
+export function KeepWeaponItemLevels(): boolean {
+    return (process.env.KEEP_WEAPON_ITEM_LEVELS ?? "").trim().toLowerCase() === "true";
+}
+
+// itemData with CurrentLevel set to 0 for a weapon (catalog id WP_...) whose level is above 0;
+// anything else (other items, no level, unparsable data) is returned unchanged.
+export function WeaponItemDataAtBaseLevel(catalogId: unknown, itemData: unknown): unknown {
+    if (typeof catalogId !== "string" || !catalogId.startsWith("WP_") || typeof itemData !== "string") return itemData;
+    if (!itemData.includes("CurrentLevel")) return itemData;
+    let Parsed: any;
+    try { Parsed = JSON.parse(itemData); } catch { return itemData; }
+    if (Parsed == null || typeof Parsed !== "object" || Array.isArray(Parsed)) return itemData;
+    if (typeof Parsed.CurrentLevel !== "number" || Parsed.CurrentLevel <= 0) return itemData;
+    return JSON.stringify({ ...Parsed, CurrentLevel: 0 });
+}
+
+// A copy of `value` in which every item object ({catalogId, itemData}) found in it, in arrays or
+// object fields up to a few levels deep, has its weapon level served as 0. Nothing is mutated.
+export function ServeWeaponsAtBaseLevel<T>(value: T, depth: number = 0): T {
+    if (KeepWeaponItemLevels() || value == null || typeof value !== "object" || depth > 4) return value;
+    if (Array.isArray(value)) {
+        let Changed = false;
+        const Out = value.map((entry) => {
+            const Next = ServeWeaponsAtBaseLevel(entry, depth + 1);
+            if (Next !== entry) Changed = true;
+            return Next;
+        });
+        return (Changed ? Out : value) as T;
+    }
+    const Source = value as any;
+    let Out: any = undefined;
+    if ("catalogId" in Source && "itemData" in Source) {
+        const ItemData = WeaponItemDataAtBaseLevel(Source.catalogId, Source.itemData);
+        if (ItemData !== Source.itemData) Out = { ...Source, itemData: ItemData };
+    }
+    for (const Key of Object.keys(Source)) {
+        const Field = Source[Key];
+        if (Field == null || typeof Field !== "object") continue;
+        const Next = ServeWeaponsAtBaseLevel(Field, depth + 1);
+        if (Next !== Field) {
+            if (Out === undefined) Out = { ...Source };
+            Out[Key] = Next;
+        }
+    }
+    return (Out ?? value) as T;
+}
