@@ -0,0 +1,12 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { GauntletMapPath } from "./gauntletLaunch";
+test("Gauntlet launches with the chosen native map option", () => {
+    assert.equal(GauntletMapPath("/Game/Gauntlet"), "/Game/Gauntlet?GauntletLevel=10000001");
+    assert.equal(GauntletMapPath("/Game/Gauntlet", 7), "/Game/Gauntlet?GauntletLevel=10000007");
+});
+test("invalid or duplicate Gauntlet launch options are refused", () => {
+    for (const value of [0, -1, 1.5, NaN, Infinity]) assert.throws(() => GauntletMapPath("/Game/Gauntlet", value));
+    assert.throws(() => GauntletMapPath("bad", 1));
+    assert.throws(() => GauntletMapPath("/Game/Gauntlet?GauntletLevel=10000001", 2));
+});
