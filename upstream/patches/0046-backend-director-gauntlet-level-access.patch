@@ -0,0 +1,52 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { GauntletNativeLevel, RequestedGauntletLevel, IsGauntletLevelAllowed, CompletedGauntletLevel, GauntletAccountAllowed, GauntletLevelAccess, GauntletProgressPayload, GauntletSeasonConfig } from "./gauntletProgress";
+
+test("a fresh Gauntlet player has zero completions and access to level one only", () => {
+    assert.equal(GauntletLevelAccess(undefined), 1);
+    assert.deepEqual(GauntletProgressPayload(undefined), { personal_progression: 0, guild_progression: 0 });
+});
+test("access is the next level after the saved completion, returned as an integer", () => {
+    assert.equal(GauntletLevelAccess(2), 3);
+    assert.equal(typeof GauntletLevelAccess(0), "number");
+});
+test("invalid saved values do not unlock levels", () => {
+    for (const value of [-1, NaN, Infinity, "99", 1.5, 2147483647]) {
+        assert.equal(CompletedGauntletLevel(value), 0);
+        assert.equal(GauntletLevelAccess(value), 1);
+    }
+});
+test("one player cannot read another player's Gauntlet progress", () => {
+    assert.equal(GauntletAccountAllowed({ userId: "a" }, "a"), true);
+    assert.equal(GauntletAccountAllowed({ userId: "a" }, "b"), false);
+    assert.equal(GauntletAccountAllowed(undefined, "a"), false);
+    assert.equal(GauntletAccountAllowed({ IsGameserver: true }, "a"), true);
+    assert.equal(GauntletAccountAllowed({ IsGameserver: true }, { $ne: null }), false);
+});
+test("season dates cover the running game", () => {
+    const season = GauntletSeasonConfig();
+    assert.ok(Date.parse(season.start_at) < Date.now());
+    assert.ok(Date.parse(season.end_at) > Date.now());
+});
+
+test("higher levels cannot be selected before preceding completions", () => {
+    assert.equal(IsGauntletLevelAllowed(0, 1), true);
+    for (const level of [0, 2, 100, "1", null, NaN]) assert.equal(IsGauntletLevelAllowed(0, level), false);
+    assert.equal(IsGauntletLevelAllowed(1, 2), true);
+    assert.equal(IsGauntletLevelAllowed(1, 3), false);
+});
+
+test("selected Gauntlet level accepts scalar and native structured payloads without unlocking higher levels", () => {
+    for (const value of [1, "1", { level: 1 }, { gauntlet_id: "Season01", level: 1 }]) assert.equal(RequestedGauntletLevel(value), 1);
+    for (const value of [0, -1, [], {}, { level: "bad" }, "1x"]) assert.equal(RequestedGauntletLevel(value), undefined);
+    assert.equal(IsGauntletLevelAllowed(0, RequestedGauntletLevel({ level: 2 })), false);
+});
+
+test("native Season01 level IDs are decoded before checking progression", () => {
+    assert.equal(RequestedGauntletLevel(10000001), 1);
+    assert.equal(RequestedGauntletLevel({ level: 10000001 }), 1);
+    assert.equal(IsGauntletLevelAllowed(0, RequestedGauntletLevel(10000001)), true);
+    assert.equal(IsGauntletLevelAllowed(0, RequestedGauntletLevel(10000002)), false);
+    assert.equal(RequestedGauntletLevel(20000001), undefined);
+    assert.equal(GauntletNativeLevel(GauntletLevelAccess(0)), 10000001);
+});
