@@ -0,0 +1,8 @@
+// Unreal map URL option read by AArchonGameMode::InitGame in build 647472.
+export function GauntletMapPath(map: string, level: number = 1): string {
+    if (!map.startsWith("/Game/") || !Number.isSafeInteger(level) || level < 1 || level >= 10000000) {
+        throw new Error("Invalid Gauntlet launch parameters");
+    }
+    if (/\?GauntletLevel=/i.test(map)) throw new Error("Duplicate Gauntlet level option");
+    return `${map}?GauntletLevel=${10000000 + level}`;
+}
