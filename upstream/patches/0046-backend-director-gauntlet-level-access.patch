@@ -0,0 +1,49 @@
+import { GetMongoDb } from "./persistence/mongo/client";
+
+export const GAUNTLET_COLLECTION = "gauntletProgress";
+export const GAUNTLET_SEASON_ID = "Season01";
+
+export function CompletedGauntletLevel(value: unknown): number {
+    return typeof value === "number" && Number.isSafeInteger(value) && value >= 0 && value < 2147483647 ? value : 0;
+}
+
+export function GauntletLevelAccess(completedLevel: unknown): number {
+    return CompletedGauntletLevel(completedLevel) + 1;
+}
+
+export function GauntletProgressPayload(completedLevel: unknown) {
+    return { personal_progression: CompletedGauntletLevel(completedLevel), guild_progression: 0 };
+}
+
+export function GauntletAccountAllowed(auth: { IsGameserver?: boolean; userId?: string } | undefined, userId: unknown): userId is string {
+    return typeof userId === "string" && /^[A-Za-z0-9_-]{1,128}$/.test(userId)
+        && (auth?.IsGameserver === true || auth?.userId === userId);
+}
+
+export async function ReadGauntletCompletedLevel(season: string, userId: string): Promise<number> {
+    const db = await GetMongoDb();
+    const row = await db.collection(GAUNTLET_COLLECTION).findOne({ _id: `${season}:${userId}` as any });
+    return CompletedGauntletLevel(row?.completedLevel);
+}
+
+export function GauntletSeasonConfig() {
+    return { gauntlet_id: GAUNTLET_SEASON_ID, start_at: "2020-01-01T00:00:00+00:00", end_at: "2099-12-31T23:59:59+00:00" };
+}
+
+export function IsGauntletLevelAllowed(completed: unknown, requested: unknown): boolean {
+    return typeof requested === "number" && Number.isSafeInteger(requested) && requested >= 1 && requested <= GauntletLevelAccess(completed);
+}
+
+export function RequestedGauntletLevel(value: unknown): number | undefined {
+    const raw = value != null && typeof value === "object" && !Array.isArray(value) ? (value as { level?: unknown }).level : value;
+    const parsed = typeof raw === "string" && /^[1-9][0-9]{0,8}$/.test(raw) ? Number(raw) : raw;
+    if (typeof parsed !== "number" || !Number.isSafeInteger(parsed) || parsed < 1) return undefined;
+    // Native FGauntletLevel numbers include the season: Season01 level 1 = 10000001.
+    if (parsed >= 10000000) return parsed > 10000000 && parsed < 20000000 ? parsed - 10000000 : undefined;
+    return parsed;
+}
+
+export function GauntletNativeLevel(level: number): number {
+    if (!Number.isSafeInteger(level) || level < 1 || level >= 10000000) throw new Error("Invalid Gauntlet level");
+    return 10000000 + level;
+}
