     MpLog(std::string("[InitClientHooks] MH_Initialize=") + MH_StatusToString(InitStatus));
     StartClientHitchSampler();   // HITCH_SAMPLER.flag only
+    MpInstallWeaponPowerTableFallback("InitClientHooks");   // [Reforged 0041]
 
     // Observe the same verified UNetConnection::Close entry used by the server.
     // This records a bounded caller stack on the client that presses Go Now, where
@@ -21978,6 +22050,7 @@ void InitServerHooks() {
     InitLog("[InitServerHooks] Entry - MH_Initialize");
     MH_Initialize();
     InitLog("[InitServerHooks] MH_Initialize OK");
