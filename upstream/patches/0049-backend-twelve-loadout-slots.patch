@@ -0,0 +1,52 @@
+/**
+ * Preserves a stored weapon level when the client sends back
+ * the synthetic level zero produced by Reforged 0036.
+ *
+ * Not connected to production inventory persistence.
+ */
+export function PreserveStoredWeaponLevel(
+    catalogId: unknown,
+    storedItemData: unknown,
+    incomingItemData: unknown
+): unknown {
+    if (
+        typeof catalogId !== "string" ||
+        !catalogId.startsWith("WP_") ||
+        typeof storedItemData !== "string" ||
+        typeof incomingItemData !== "string"
+    ) {
+        return incomingItemData;
+    }
+
+    try {
+        const stored = JSON.parse(storedItemData);
+        const incoming = JSON.parse(incomingItemData);
+
+        if (
+            stored === null ||
+            incoming === null ||
+            typeof stored !== "object" ||
+            typeof incoming !== "object" ||
+            Array.isArray(stored) ||
+            Array.isArray(incoming)
+        ) {
+            return incomingItemData;
+        }
+
+        if (
+            typeof stored.CurrentLevel === "number" &&
+            Number.isInteger(stored.CurrentLevel) &&
+            stored.CurrentLevel > 0 &&
+            incoming.CurrentLevel === 0
+        ) {
+            return JSON.stringify({
+                ...incoming,
+                CurrentLevel: stored.CurrentLevel
+            });
+        }
+
+        return incomingItemData;
+    } catch {
+        return incomingItemData;
+    }
+}
