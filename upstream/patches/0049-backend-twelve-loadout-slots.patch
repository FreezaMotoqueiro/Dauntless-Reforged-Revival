diff --git a/ParadoxBackend/src/weaponLevelPersistence.test.ts b/ParadoxBackend/src/weaponLevelPersistence.test.ts
new file mode 100644
--- /dev/null
+++ b/ParadoxBackend/src/weaponLevelPersistence.test.ts
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { PreserveStoredWeaponLevel } from "./weaponLevelPersistence";
+
+test("preserves stored weapon level when client returns synthetic zero", () => {
+    const stored = JSON.stringify({ CurrentLevel: 14, Cells: ["old"] });
+    const incoming = JSON.stringify({ CurrentLevel: 0, Cells: ["new"] });
+
+    const result = PreserveStoredWeaponLevel("WP_GA_FUNGUY", stored, incoming);
+
+    assert.deepEqual(JSON.parse(result as string), {
+        CurrentLevel: 14,
+        Cells: ["new"]
+    });
+});
+
+test("allows legitimate positive level updates", () => {
+    const stored = JSON.stringify({ CurrentLevel: 5 });
+    const incoming = JSON.stringify({ CurrentLevel: 6 });
+
+    assert.equal(
+        PreserveStoredWeaponLevel("WP_GA_FUNGUY", stored, incoming),
+        incoming
+    );
+});
+
+test("does not modify non-weapon items", () => {
+    const stored = JSON.stringify({ CurrentLevel: 10 });
+    const incoming = JSON.stringify({ CurrentLevel: 0 });
+
+    assert.equal(
+        PreserveStoredWeaponLevel("AR_HEAD_TEST", stored, incoming),
+        incoming
+    );
+});
+
+test("does not modify invalid or missing item data", () => {
+    assert.equal(
+        PreserveStoredWeaponLevel("WP_GA_FUNGUY", "invalid", '{"CurrentLevel":0}'),
+        '{"CurrentLevel":0}'
+    );
+
+    assert.equal(
+        PreserveStoredWeaponLevel("WP_GA_FUNGUY", '{"Other":1}', '{"CurrentLevel":0}'),
+        '{"CurrentLevel":0}'
+    );
+});
+
+test("preserves already-zero weapons", () => {
+    const incoming = '{"CurrentLevel":0}';
+
+    assert.equal(
+        PreserveStoredWeaponLevel("WP_GA_FUNGUY", '{"CurrentLevel":0}', incoming),
+        incoming
+    );
+});
