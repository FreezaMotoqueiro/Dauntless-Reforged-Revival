--- a/ParadoxRuntime/dllmain.cpp
+++ b/ParadoxRuntime/dllmain.cpp
@@ -3763,6 +3763,28 @@ void ArchonLoadManagerLoadFailedHook(void* This) {
     }
 
     playerController = SafeReadPtr(self, 0x20);
+
+    // [Dauntless Reforged Revival] The hub's own phantom local player (the ULocalPlayer its forced
+    // listen-server boot spawns, see PHANTOM REPLICATION SUPPRESSION) has a PlayerState with no net-id
+    // object, so its progression component never loads ("the player state does not have a valid ID") and
+    // its player data always times out. The game's terminal handler then reloads the hub's map
+    // ("LoadMap: failed to Listen") and every connected player is disconnected, about two minutes after
+    // each hub start, while the real players' loads have all completed. The phantom needs no player data:
+    // on the server its failure is dropped here. Real players always carry a net id (PlayerState+0x258,
+    // the field EnsureSyntheticNetId and the phantom-load skip read). KEEP_PHANTOM_LOAD_FAILURE.flag next to
+    // the game executable restores the original handling.
+    if (Globals::AmServer && playerController
+        && !MpExeRelativeFlagPresent(L"KEEP_PHANTOM_LOAD_FAILURE.flag")) {
+        const uintptr_t PhantomPlayerState = SafeReadPtr(playerController, 0x228);
+        const uintptr_t PhantomNetId = PhantomPlayerState ? SafeReadPtr(PhantomPlayerState, 0x258) : 0;
+        if (PhantomPlayerState && !PhantomNetId) {
+            MpLog("[PhantomLoadFailure] dropped: the owner has no net id (playerController="
+                + MpPtr(reinterpret_cast<void*>(playerController)) + " playerState="
+                + MpPtr(reinterpret_cast<void*>(PhantomPlayerState)) + ") - the hub keeps listening");
+            return;
+        }
+    }
+
     uintptr_t arrayBase = SafeReadPtr(self, 0x48);
     int32_t   arrayCount = SafeReadI32At(self, 0x50);
 
