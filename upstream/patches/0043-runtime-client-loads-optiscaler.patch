@@ -22677,24 +22677,42 @@ void InitServerHooks() {
 // runtime loads it here, on the client only, before the engine creates its D3D11 device. ReShade then finds
 // the add-on and its shaders beside itself. The server role (-server) and -nullrhi never load it.
 // DISABLE_UPSCALER.flag beside the game executable turns it off without uninstalling.
+// [Reforged 0043] OptiScaler (github.com/optiscaler/OptiScaler) over Luma: Luma hands its DLSS calls to
+// OptiScaler, which runs FSR 4 / FSR 3.1 or XeSS through a background D3D12 device, or DLSS itself, as the
+// player picks in its overlay. OptiScaler.dll is its non-proxy name (nothing loads it on its own); with
+// LoadReshade=true in OptiScaler.ini it loads ReShade64.dll itself, after the D3D12 device it creates for Luma,
+// so the runtime loads OptiScaler.dll instead of ReShade64.dll when both are installed. Same rules as 0041:
+// client only, never with -nullrhi, DISABLE_UPSCALER.flag turns both off. DISABLE_OPTISCALER.flag keeps Luma
+// alone (DLSS on NVIDIA, FSR 3.1 elsewhere).
+static bool MpLoadExeRelativeModule(const wchar_t* Name, size_t NameLen, const char* LogName) {
+    wchar_t Path[MAX_PATH];
+    const size_t DirLen = MpExeDirFromModuleW(Path);
+    if (DirLen == 0 || DirLen + NameLen + 1 > MAX_PATH) return false;
+    for (size_t i = 0; i <= NameLen; ++i) Path[DirLen + i] = Name[i];
+    HMODULE Module = LoadLibraryW(Path);
+    const DWORD LoadError = Module ? 0 : GetLastError();
+    // InitLog is compiled out; MpLog reaches mysticparadox_dll_port0.log.
+    MpLog(std::string("[Upscaler] ") + LogName + (Module ? " loaded" : (" failed error=" + std::to_string(LoadError))));
+    return Module != nullptr;
+}
+
 static void MpLoadClientUpscaler() {
