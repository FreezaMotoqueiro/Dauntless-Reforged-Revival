     if (MpOsCommandLineHas(L"-nullrhi")) return;
-    if (!MpExeRelativeFlagPresent(L"ReShade64.dll")) { MpLog("[Upscaler] not installed (no ReShade64.dll beside the game executable)"); return; }
+    const bool HaveReShade = MpExeRelativeFlagPresent(L"ReShade64.dll");
+    const bool HaveOptiScaler = MpExeRelativeFlagPresent(L"OptiScaler.dll");
+    if (!HaveReShade) { MpLog("[Upscaler] not installed (no ReShade64.dll beside the game executable)"); return; }
     if (MpExeRelativeFlagPresent(L"DISABLE_UPSCALER.flag")) {
         MpLog("[Upscaler] ReShade64.dll present, DISABLE_UPSCALER.flag set: not loaded");
         return;
     }
-    wchar_t Path[MAX_PATH];
-    const size_t DirLen = MpExeDirFromModuleW(Path);
-    static const wchar_t kName[] = L"ReShade64.dll";
-    const size_t NameLen = (sizeof(kName) / sizeof(kName[0])) - 1;
-    if (DirLen == 0 || DirLen + NameLen + 1 > MAX_PATH) return;
-    for (size_t i = 0; i <= NameLen; ++i) Path[DirLen + i] = kName[i];
-    HMODULE Module = LoadLibraryW(Path);
-    const DWORD LoadError = Module ? 0 : GetLastError();
-    // InitLog is compiled out; MpLog reaches mysticparadox_dll_port0.log.
-    MpLog(std::string("[Upscaler] ReShade64.dll ") + (Module ? "loaded" : ("failed error=" + std::to_string(LoadError))));
+    static const wchar_t kOpti[] = L"OptiScaler.dll";
+    static const wchar_t kReShade[] = L"ReShade64.dll";
+    if (HaveOptiScaler && !MpExeRelativeFlagPresent(L"DISABLE_OPTISCALER.flag")) {
+        // OptiScaler loads ReShade64.dll (and with it Luma) itself.
+        if (MpLoadExeRelativeModule(kOpti, (sizeof(kOpti) / sizeof(kOpti[0])) - 1, "OptiScaler.dll")) return;
