+// [Dauntless Reforged Revival] Server side of the [WeaponGap] log.
+//
+// A hunt with the crafted hammer (WP_IH_ROCK) never finishes loading. The client's [WeaponGap] lines
+// (16 Oct, 23:55) show the hammer actor reaching the client and already being destroyed there
+// (bActorIsBeingDestroyed=1, owner=null) 4 s after ClientRestart, with no other weapon ever arriving,
+// while the armour and lantern arrive and equip normally. A client cannot destroy a replicated actor it
+// does not own, so the server either destroyed the hammer or stopped replicating it (its actor channel was
+// closed). Neither the game's own server log nor this module's log records weapons, so this logs, for
+// each connected player's pawn in a hunt, the server's view of every weapon and of the equipment that pawn
+// owns: owner, equipped flags, location and distance from the pawn, what it is attached to, its cull
+// distance, and its replication-graph state for that player's connection (whether the connection still has
+// an actor channel for it). Logging only, at a few fixed times after the pawn first appears.
+static bool GetActorWorldLocation(void* Actor, float& X, float& Y, float& Z);
+
+static void MpLogServerWeaponGap() {
+    if (!Globals::AmServer || Globals::AuthMode != Globals::ServerAuthMode::GlobalGameserver) return;
+    if (g_wdIsHub.load(std::memory_order_relaxed) != 0) return;   // hunts only
+    if (!Networking::NetDriver || !SDK::UObject::GObjects) return;
+
+    static uint64_t s_nextPollMs = 0;
+    const uint64_t Now = static_cast<uint64_t>(GetTickCount64());
+    if (Now < s_nextPollMs) return;
+    s_nextPollMs = Now + 250;
+
+    static int s_disabled = -1;
+    if (s_disabled < 0) s_disabled = MpExeRelativeFlagPresent(L"DISABLE_SERVER_WEAPON_GAP_LOG.flag") ? 1 : 0;
+    if (s_disabled == 1) return;
+
+    const RawPointerArray* Clients = reinterpret_cast<const RawPointerArray*>(
+        reinterpret_cast<uintptr_t>(Networking::NetDriver) + 0x90);
+    if (!IsReadablePointer(Clients, sizeof(RawPointerArray))
+        || !IsSanePointerArray(Clients->Data, Clients->Num, Clients->Max, 1024)) return;
+    void* Graph = reinterpret_cast<void*>(
+        SafeReadPtr(reinterpret_cast<uintptr_t>(Networking::NetDriver), 0x6E8));
+
+    // Keyed on (pawn pointer, UObject InternalIndex at +0x0C) so a new pawn at a reused address starts over.
+    struct Track { uintptr_t Pawn; int32_t Index; uint64_t FirstSeenMs; int Stage; };
+    static Track s_tracks[8] = {};
+    static int s_trackNext = 0;
+    static const uint64_t kStagesMs[] = { 500, 1500, 3000, 5000, 10000, 30000 };
+    constexpr int kStageCount = static_cast<int>(sizeof(kStagesMs) / sizeof(kStagesMs[0]));
+
+    auto Name = [](uintptr_t Ptr) { return SafeObjectNameForDiagnostic(reinterpret_cast<void*>(Ptr)); };
+    auto Loc = [](uintptr_t Actor, float& X, float& Y, float& Z) {
+        return GetActorWorldLocation(reinterpret_cast<void*>(Actor), X, Y, Z);
+    };
+    auto Fmt = [](float V) {
+        char Buf[48];
+        snprintf(Buf, sizeof(Buf), "%.0f", static_cast<double>(V));
+        return std::string(Buf);
+    };
+
+    for (int32_t c = 0; c < Clients->Num; ++c) {
+        void* Conn = Clients->Data[c];
+        if (!Conn || !IsReadablePointer(Conn, 0x98) || !IsRegisteredLiveObject(Conn)) continue;
+        const uintptr_t Pc = SafeReadPtr(reinterpret_cast<uintptr_t>(Conn), 0x30);
+        if (!Pc || !IsReadablePointer(reinterpret_cast<void*>(Pc), 0x420)) continue;
+        const uintptr_t P = SafeReadPtr(Pc, 0x250);
+        if (!P || !IsReadablePointer(reinterpret_cast<void*>(P), 0x748)
+            || !IsRegisteredLiveObject(reinterpret_cast<void*>(P))
+            || !reinterpret_cast<SDK::UObject*>(P)->IsA(SDK::AArchonCharacter::StaticClass())) continue;
+
+        const int32_t Index = SafeReadI32At(P, 0x0C);
+        Track* T = nullptr;
+        for (Track& E : s_tracks) { if (E.Pawn == P && E.Index == Index) { T = &E; break; } }
+        if (!T) {
+            T = &s_tracks[s_trackNext++ % 8];
+            *T = { P, Index, Now, 0 };
+        }
+        if (T->Stage >= kStageCount) continue;
+        const uint64_t Since = Now - T->FirstSeenMs;
+        if (Since < kStagesMs[T->Stage]) continue;
+        ++T->Stage;
+
+        float PX = 0, PY = 0, PZ = 0;
+        const bool PawnLoc = Loc(P, PX, PY, PZ);
+        void* Manager = Graph ? FindRepGraphConnectionManager(Graph, Conn) : nullptr;
+
+        // AArchonCharacter (1.14.7 SDK): Weapon +0x5F0, Helmet/Chest/Legs/Arms +0x700..+0x718, Lantern +0x720.
+        MpLog("[ServerWeaponGap] stage=" + std::to_string(T->Stage) + " sincePawnSeenMs=" + std::to_string(Since)
+            + " conn=" + MpPtr(Conn) + " pc=" + Name(Pc) + " pawn=" + Name(P)
+            + " pawnLoc=" + (PawnLoc ? "(" + Fmt(PX) + "," + Fmt(PY) + "," + Fmt(PZ) + ")" : std::string("?"))
+            + " weapon=" + Name(SafeReadPtr(P, 0x5F0))
+            + " helmet=" + Name(SafeReadPtr(P, 0x700))
+            + " chest=" + Name(SafeReadPtr(P, 0x708))
+            + " legs=" + Name(SafeReadPtr(P, 0x710))
+            + " arms=" + Name(SafeReadPtr(P, 0x718))
+            + " lantern=" + Name(SafeReadPtr(P, 0x720))
+            + " repGraphConnection=" + (Manager ? "found" : "missing"));
+
+        const int Count = SDK::UObject::GObjects->Num();
+        int Logged = 0;
+        for (int i = 0; i < Count && Logged < 16; ++i) {
+            SDK::UObject* Obj = SDK::UObject::GObjects->GetByIndex(i);
+            if (!Obj || Obj->IsDefaultObject()) continue;
+            if (!Obj->IsA(SDK::AArchonEquipment::StaticClass()) || !IsReadablePointer(Obj, 0x300)) continue;
+            const uintptr_t A = reinterpret_cast<uintptr_t>(Obj);
+            const bool IsWeapon = Obj->IsA(SDK::AArchonWeapon::StaticClass());
+            const uintptr_t Owner = SafeReadPtr(A, 0xE0);
+            // Every weapon (a hunt has only the players' own), and the rest of this pawn's equipment for
+            // comparison.
+            if (!IsWeapon && Owner != P) continue;
+
+            float X = 0, Y = 0, Z = 0;
+            const bool HasLoc = Loc(A, X, Y, Z);
+            std::string Where = "?";
+            if (HasLoc) {
+                Where = "(" + Fmt(X) + "," + Fmt(Y) + "," + Fmt(Z) + ")";
+                if (PawnLoc) {
+                    const float DX = X - PX, DY = Y - PY, DZ = Z - PZ;
+                    Where += " distToPawn=" + Fmt(std::sqrt(DX * DX + DY * DY + DZ * DZ));
+                }
+            }
+            // AActor: NetCullDistanceSquared +0x100, RootComponent +0x130; USceneComponent: AttachParent +0xC0.
+            // A component's Outer (+0x20) is the actor that owns it.
+            const uintptr_t Root = SafeReadPtr(A, 0x130);
+            const uintptr_t AttachParent = Root ? SafeReadPtr(Root, 0xC0) : 0;
+            const uintptr_t AttachActor = AttachParent ? SafeReadPtr(AttachParent, 0x20) : 0;
+            float NetCullSq = 0.0f;
+            if (IsReadablePointer(reinterpret_cast<void*>(A + 0x100), 4)) {
+                NetCullSq = *reinterpret_cast<const float*>(A + 0x100);
+            }
+
+            std::string Rep;
+            void* Global = Graph ? RepGraphFindGlobalActorInfo(Graph, Obj) : nullptr;
+            if (Global && IsReadablePointer(Global, 0x110)) {
+                const uintptr_t G = reinterpret_cast<uintptr_t>(Global);
+                Rep += " graphCullSq=" + Fmt(*reinterpret_cast<const float*>(G + kRepGraphGlobalCullDistanceSq))
+                    + " graphChannelTimeout="
+                    + std::to_string(*reinterpret_cast<const uint16_t*>(G + kRepGraphGlobalChannelTimeout));
+            } else {
+                Rep += " graph=not-registered";
+            }
+            void* ConnInfo = Manager ? RepGraphMapFindValue(
+                reinterpret_cast<uintptr_t>(Manager) + kRepGraphConnActorInfoMap, Obj, 0x20) : nullptr;
+            if (ConnInfo && IsReadablePointer(ConnInfo, 0x30)) {
+                // FConnectionReplicationActorInfo: Channel +0x00, CullDistanceSquared +0x0C,
+                // NextReplicationFrameNum +0x10, LastRepFrameNum +0x14, ActorChannelCloseFrameNum +0x24.
+                const uintptr_t I = reinterpret_cast<uintptr_t>(ConnInfo);
+                Rep += " channel=" + MpPtr(*reinterpret_cast<void* const*>(I))
+                    + " connCullSq=" + Fmt(*reinterpret_cast<const float*>(I + 0x0C))
+                    + " lastRepFrame=" + std::to_string(*reinterpret_cast<const int32_t*>(I + 0x14))
+                    + " closeFrame=" + std::to_string(*reinterpret_cast<const int32_t*>(I + 0x24));
+            } else {
+                Rep += " connInfo=none";
+            }
+
+            // AActor: Owner +0xE0, Role +0xF0, RemoteRole +0x5F. AArchonEquipment: LoadoutItemSlotType +0x238,
+            // ItemId FString +0x240, bIsEquipped +0x2F4, bIsEquippedForGameplay +0x2F5, bIsActiveGameplay +0x2F6.
+            std::string Line = "[ServerWeaponGap]   item=" + Obj->GetName()
+                + " owner=" + Name(Owner) + (Owner == P ? "(this pawn)" : "")
+                + " dying=" + std::to_string(reinterpret_cast<SDK::AActor*>(Obj)->bActorIsBeingDestroyed ? 1 : 0)
+                + " slotType=" + std::to_string(SafeReadU8At(A, 0x238))
+                + " itemId=" + CoreCapFString(reinterpret_cast<void*>(A + 0x240))
+                + " equipped=" + std::to_string(SafeReadU8At(A, 0x2F4))
+                + " equippedForGameplay=" + std::to_string(SafeReadU8At(A, 0x2F5))
+                + " activeGameplay=" + std::to_string(SafeReadU8At(A, 0x2F6))
+                + " loc=" + Where
+                + " attachedTo=" + Name(AttachActor)
+                + " netCullSq=" + Fmt(NetCullSq) + Rep;
+            if (IsWeapon && IsReadablePointer(Obj, 0x7E0)) {
+                // AArchonWeapon: PlayerSkelMesh +0x4B0, WeaponSlotIndex +0x6F8, CurrentLevel +0x6FC,
+                // EquippedWeaponParts Num +0x710.
+                Line += " slotIndex=" + std::to_string(SafeReadI32At(A, 0x6F8))
+                    + " level=" + std::to_string(SafeReadU8At(A, 0x6FC))
+                    + " parts=" + std::to_string(SafeReadI32At(A, 0x710))
+                    + " playerSkelMesh=" + Name(SafeReadPtr(A, 0x4B0));
+            }
+            MpLog(Line);
+            ++Logged;
+        }
+    }
+}
+
 static void MpSuppressPhantomReplication() {
