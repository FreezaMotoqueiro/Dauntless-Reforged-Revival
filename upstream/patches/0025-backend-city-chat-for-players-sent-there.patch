diff --git a/ParadoxBackend/src/realtime/cityRooms.test.ts b/ParadoxBackend/src/realtime/cityRooms.test.ts
new file mode 100644
index 0000000..7894eb9
--- /dev/null
+++ b/ParadoxBackend/src/realtime/cityRooms.test.ts
@@ -0,0 +1,50 @@
+// [Reforged 0025] City chat rooms are open to the accounts matchmaking sent to that hub.
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { MayJoinCityRoom, RecordHubSessionServed, ResetCityRoomsForTest } from "./cityRooms";
+import { RoomService } from "./RoomService";
+import type { RegisteredConnection } from "./SessionRegistry";
+
+class FakeConnection implements RegisteredConnection {
+    readonly sent: string[] = [];
+    constructor(readonly connId: string, readonly accountId: string, readonly resource: string) {}
+    send(frame: string): void { this.sent.push(frame); }
+    close(): void { /* no-op */ }
+}
+
+const HUB = "179cf2a8-0716-49f5-9027-6e4876ba0d76";
+const OTHER = "c069ba56-fe67-40b7-8e19-cb4a4813dc22";
+const DOMAIN = "muc.prod.ol.epicgames.com";
+
+test("only the hub an account was last sent to opens its City room", () => {
+    ResetCityRoomsForTest();
+    assert.equal(MayJoinCityRoom("alice", `City-${HUB}`), false);
+    RecordHubSessionServed("alice", HUB);
+    assert.equal(MayJoinCityRoom("alice", `City-${HUB}`), true);
+    assert.equal(MayJoinCityRoom("alice", `City-${OTHER}`), false);
+    assert.equal(MayJoinCityRoom("bob", `City-${HUB}`), false);
+    assert.equal(MayJoinCityRoom("alice", `Hunt-${HUB}`), false);
+    RecordHubSessionServed("alice", OTHER);
+    assert.equal(MayJoinCityRoom("alice", `City-${HUB}`), false);
+    assert.equal(MayJoinCityRoom("alice", `City-${OTHER}`), true);
+    assert.equal(MayJoinCityRoom("alice", `City-${OTHER}`, Date.now() + 8 * 24 * 3600 * 1000), false);
+});
+
+test("with the dev switch off, players sent to the hub chat in its room and others are refused", async () => {
+    ResetCityRoomsForTest();
+    RecordHubSessionServed("alice", HUB);
+    RecordHubSessionServed("bob", HUB);
+    const service = new RoomService(false);
+    const alice = new FakeConnection("ca", "alice", "ra");
+    const bob = new FakeConnection("cb", "bob", "rb");
+    const eve = new FakeConnection("ce", "eve", "re");
+    const room = `City-${HUB}@${DOMAIN}`;
+
+    assert.match((await service.joinRoom(alice, `${room}/Alice:alice:ra`))[0], /status code="110"/);
+    assert.match((await service.joinRoom(bob, `${room}/Bob:bob:rb`))[1], /status code="110"/);
+    assert.match((await service.joinRoom(eve, `${room}/Eve:eve:re`))[0], /type="error"/);
+
+    service.groupMessage(alice, room, "m1", "oi");
+    assert.match(bob.sent.at(-1)!, /<body>oi<\/body>/);
+});
diff --git a/ParadoxBackend/src/realtime/cityRooms.ts b/ParadoxBackend/src/realtime/cityRooms.ts
new file mode 100644
index 0000000..ba1e273
--- /dev/null
+++ b/ParadoxBackend/src/realtime/cityRooms.ts
@@ -0,0 +1,40 @@
+/*
+ * Reforged patch 0025: who may join a City (Ramsgate / dojo) chat room.
+ *
+ * The client names a hub's room City-<gameSessionId>, from serverInfo.gameSessionId in the
+ * /candidate/status answer that sent it to that hub. The backend therefore knows exactly which
+ * accounts were sent to which hub: an account may join City-<id> when the last hub session it was
+ * sent to is <id>. This replaces the insecure dev switch (any account, any City room), which
+ * production must keep off, so Ramsgate chat, quick chat and emojis (all sent to the City room)
+ * were refused for everyone.
+ */
+
+const HUB_SESSION_TTL_MS = 7 * 24 * 60 * 60 * 1000;
+const MAX_ACCOUNTS = 50_000;
+
+const lastHubSessionByAccount = new Map<string, { gameSessionId: string; at: number }>();
+
+/** Called when matchmaking tells an account to travel to a hub with this game session id. */
+export function RecordHubSessionServed(accountId: string, gameSessionId: string, now = Date.now()): void {
+    if (!accountId || !gameSessionId) return;
+    lastHubSessionByAccount.delete(accountId);
+    lastHubSessionByAccount.set(accountId, { gameSessionId, at: now });
+    while (lastHubSessionByAccount.size > MAX_ACCOUNTS) {
+        const oldest = lastHubSessionByAccount.keys().next().value;
+        if (oldest === undefined) break;
+        lastHubSessionByAccount.delete(oldest);
+    }
+}
+
+/** True when roomLocal is City-<id> and <id> is the hub session this account was last sent to. */
+export function MayJoinCityRoom(accountId: string, roomLocal: string, now = Date.now()): boolean {
+    if (!roomLocal.startsWith("City-")) return false;
+    const entry = lastHubSessionByAccount.get(accountId);
+    if (!entry || now - entry.at > HUB_SESSION_TTL_MS) return false;
+    return roomLocal.slice("City-".length) === entry.gameSessionId;
+}
+
+/** Tests only. */
+export function ResetCityRoomsForTest(): void {
+    lastHubSessionByAccount.clear();
+}
