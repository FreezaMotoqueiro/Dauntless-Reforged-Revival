@@ -13,6 +13,45 @@
 // The stored level is left as it is; only what the game reads is set to 0, so the base table is used.
 // KEEP_WEAPON_ITEM_LEVELS=true serves the stored levels again.
 
+// [Dauntless Reforged Revival 0042] Weapons are served at their stored level again, and a save never lowers it.
+//
+// Serving level 0 made every weapon upgraded with Aether Hearts look reset when the player opened the game,
+// and the game then saved that level 0 back with the weapon's next save (cells, parts, ...), which
+// overwrote the stored level (players' reports, 2026-10-25). Runtime patch 0041 now gives upgraded
+// weapons a power table, so the workaround is off by default: SERVE_WEAPONS_AT_BASE_LEVEL=true turns it
+// back on. KeepStoredWeaponLevel (used by every itemData save) keeps a weapon's stored CurrentLevel when a
+// save carries a lower one; ALLOW_WEAPON_LEVEL_DOWNGRADE=true lets such saves through.
+
+export function ServeWeaponsAtBaseLevelEnabled(): boolean {
+    return (process.env.SERVE_WEAPONS_AT_BASE_LEVEL ?? "").trim().toLowerCase() === "true" && !KeepWeaponItemLevels();
+}
+
+export function AllowWeaponLevelDowngrade(): boolean {
+    return (process.env.ALLOW_WEAPON_LEVEL_DOWNGRADE ?? "").trim().toLowerCase() === "true";
+}
+
+function ParseItemData(itemData: unknown): any | undefined {
+    if (typeof itemData !== "string" || !itemData.includes("CurrentLevel")) return undefined;
+    try {
+        const Parsed = JSON.parse(itemData);
+        return Parsed != null && typeof Parsed === "object" && !Array.isArray(Parsed) ? Parsed : undefined;
+    } catch { return undefined; }
+}
+
+// The itemData to store for a save of a weapon (catalog id WP_...): the incoming data, with CurrentLevel
+// raised back to the stored one when the save carries a lower (or no) level. Anything else is unchanged.
+export function KeepStoredWeaponLevel(catalogId: unknown, storedItemData: unknown, incomingItemData: unknown): unknown {
+    if (AllowWeaponLevelDowngrade() || typeof catalogId !== "string" || !catalogId.startsWith("WP_")) return incomingItemData;
+    const Stored = ParseItemData(storedItemData);
+    if (Stored === undefined || typeof Stored.CurrentLevel !== "number" || Stored.CurrentLevel <= 0) return incomingItemData;
+    if (typeof incomingItemData !== "string") return incomingItemData;
+    let Incoming: any;
+    try { Incoming = JSON.parse(incomingItemData); } catch { return incomingItemData; }
+    if (Incoming == null || typeof Incoming !== "object" || Array.isArray(Incoming)) return incomingItemData;
+    if (typeof Incoming.CurrentLevel === "number" && Incoming.CurrentLevel >= Stored.CurrentLevel) return incomingItemData;
+    return JSON.stringify({ ...Incoming, CurrentLevel: Stored.CurrentLevel });
+}
+
 export function KeepWeaponItemLevels(): boolean {
     return (process.env.KEEP_WEAPON_ITEM_LEVELS ?? "").trim().toLowerCase() === "true";
 }
