@@ -0,0 +1,53 @@
+import { ClientSession } from "mongodb";
+import { RepositoryProvider } from "../persistence";
+import { loadGameData } from "../gameData/loader";
+import { GrantEntitlementsInTransaction } from "./entitlements";
+
+export const HUNT_PASS_CLAIM_SOURCE = "Progression Track season43 Claim Rewards";
+export function HuntPassEarnedRank(Path: any, Progress: number): number {
+    const Requirements = [...Path.requirements].sort((a:any,b:any)=>a.rank_id-b.rank_id);
+    let Total=0, Rank=0;
+    for (const Row of Requirements) { Total+=Number(Row.xp_required)||0; if(Progress>=Total) Rank=Row.rank_id; }
+    const Max=Requirements.at(-1)?.rank_id??0;
+    const Step=Number(Path.prestige?.xp_per_level);
+    return Rank===Max && Step>0 ? Max+Math.floor(Math.max(0,Progress-Total)/Step) : Rank;
+}
+
+// Called INSIDE the inventory transaction: derive amounts from server-owned XP,
+// claim both entitled lanes, and commit the rank receipt with the item/wallet grant.
+// A new client transaction id cannot replay ranks already claimed by an older one.
+export async function ApplyHuntPassClaim(Repos: RepositoryProvider, Session: ClientSession, UserId: string) {
+    const Path=loadGameData<any>("progression_config.json").payload.paths.find((p:any)=>p.progression_id==="season43");
+    const Track=await Repos.progressionTracks.get(UserId,"season43",Session);
+    const Empty={stacked:[] as any[],instanced:[] as any[],receipt:{track:"season43",freeRank:0,premiumRank:0,grants:[] as any[]}};
+    if(!Track) return Empty;
+    const Earned=HuntPassEarnedRank(Path,Track.progress);
+    const Max=Math.max(...Path.requirements.map((r:any)=>r.rank_id));
+    const Entitlements=await Repos.entitlements.findByUserId(UserId,Session);
+    const Elite=(Entitlements?.entitlements??[]).some(e=>e.name===Path.premium_gating_entitlement);
+    const Quantities=new Map<string,number>();
+    const Grants: {name:string;duration:number}[]=[];
+    const Instanced:any[]=[];
+    function Add(Reward:any,Count=1){
+        for(const Item of Reward.stacked_items??[]) Quantities.set(Item.catalog_id,(Quantities.get(Item.catalog_id)??0)+Item.quantity*Count);
+        for(const Item of Reward.instanced_items??[]) Instanced.push({catalogId:typeof Item==="string"?Item:Item.catalog_id,instanceId:"",itemData:null,updateVersion:0});
+        for(const Item of Reward.ordered_instanced_items??[]) Instanced.push({catalogId:Item.catalog_id,instanceId:"",itemData:null,updateVersion:0});
+        for(const Ent of Reward.entitlements??[]) Grants.push({name:Ent.entitlement??Ent.name,duration:Ent.duration??0});
+    }
+    function Lane(Rows:any[],Confirmed:number,Prestige:any){
+        for(const Row of Rows??[]) if(Row.rank_id>Confirmed && Row.rank_id<=Math.min(Earned,Max)) Add(Row);
+        const Bonus=Math.max(0,Earned-Math.max(Max,Confirmed));
+        if(Bonus && Prestige) Add(Prestige,Bonus);
+    }
+    Lane(Path.free_rewards,Track.confirmedFremiumRank,Path.prestige?.free_rewards);
+    if(Elite) Lane(Path.premium_rewards,Track.confirmedPremiumRank,Path.prestige?.premium_rewards);
+    await GrantEntitlementsInTransaction(Repos,UserId,Grants,"huntpass-claim:season43",Session);
+    const Free=Math.max(Track.confirmedFremiumRank,Earned);
+    const Premium=Elite?Math.max(Track.confirmedPremiumRank,Earned):Track.confirmedPremiumRank;
+    await Repos.progressionTracks.confirmRewardRanks(UserId,"season43",Free,Premium,Session);
+    // Reconciliation credit is a one-time record of PREVIOUSLY completed native
+    // grants. Honour it per item, then clear it atomically with the new rank receipt.
+    const Stacked=[...Quantities].map(([catalogId,quantity])=>({catalogId,
+        quantity:Math.max(0,quantity-(Track.legacyHuntPassCredit?.[catalogId]??0))})).filter(Item=>Item.quantity>0);
+    return {stacked:Stacked,instanced:Instanced,receipt:{track:"season43",freeRank:Free,premiumRank:Premium,grants:Stacked}};
+}
