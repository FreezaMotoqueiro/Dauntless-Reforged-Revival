diff --git a/ParadoxBackend/src/tutorialHuntPass.gamedata.test.ts b/ParadoxBackend/src/tutorialHuntPass.gamedata.test.ts
new file mode 100644
--- /dev/null
+++ b/ParadoxBackend/src/tutorialHuntPass.gamedata.test.ts
@@ -0,0 +1,35 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { GetStoreSkus, FindStoreSkuByIdOrCatalogId } from "./controllers/store";
+import { GetInventoryStoragePolicy } from "./inventoryStoragePolicy";
+import { loadGameData } from "./gameData/loader";
+
+test("Recruit pack is free, one-time, visible in both sections and grants the quest token", () => {
+    const Id = "store_tutorial_dye_bundle_console";
+    const Pack = GetStoreSkus("webstore").find(x => x.id === Id)!;
+    assert(Pack);
+    assert.equal(Pack.maxAllowed, 1);
+    assert.deepEqual(Pack.prices, [{currencyId:"id_currency_platinum",price:0}]);
+    assert.equal(GetStoreSkus("dyes").find(x=>x.id===Id),Pack);
+    assert.equal(FindStoreSkuByIdOrCatalogId(Id)?.sku,Pack);
+    assert.deepEqual(Pack.items.map(x=>x.catalogId).sort(),["DYE_BLUE03_DURABLE","DYE_YELLOW03_DURABLE","TOKEN_STORE_TUTORIAL_DYE_BUNDLE"]);
+    for(const Item of Pack.items) assert.equal(GetInventoryStoragePolicy(Item.catalogId)?.storage,"stacked");
+});
+
+test("active pass retains its XP curve and has eligible native item rewards and a purchasable premium gate", () => {
+    const Pass = loadGameData<any>("progression_config.json").payload.paths.find((x:any)=>x.progression_id==="season43");
+    assert.equal(Pass.requirements.length,51);
+    assert(Pass.requirements.every((r:any)=>r.xp_required===(r.rank_id===0?0:100)));
+    assert.equal(Pass.free_rewards.find((r:any)=>r.rank_id===50).stacked_items[0].catalog_id,"CURRENCY_PLATINUM_UNIV");
+    for(const Lane of [Pass.free_rewards,Pass.premium_rewards]) {
+        assert.equal(Lane.length,51);
+        for(const Row of Lane) for(const Item of Row.stacked_items??[]) {
+            assert(GetInventoryStoragePolicy(Item.catalog_id),Item.catalog_id);
+            assert(Item.quantity>0);
+        }
+    }
+    const Premium = GetStoreSkus("season43_pass").find(x=>x.id==="season43_premium")!;
+    assert(Premium);
+    assert.equal(Premium.entitlements?.[0].name,Pass.premium_gating_entitlement);
+    assert.equal(Pass.prestige.free_rewards.stacked_items[0].catalog_id,"CURRENCY_SEASONAL_COIN");
+});
