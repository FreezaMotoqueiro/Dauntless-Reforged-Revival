+static void MpRouteWeaponAwake(void* Graph, void* Actor, void* GlobalInfo) {
+    const uintptr_t A = reinterpret_cast<uintptr_t>(Actor);
+    const uintptr_t G = (GlobalInfo && IsReadablePointer(GlobalInfo, 0x18))
+        ? reinterpret_cast<uintptr_t>(GlobalInfo) : 0;
+    const int Flags58 = SafeReadU8At(A, 0x58);
+    const int DormancyBefore = SafeReadU8At(A, 0xF1);
+    const int WantsBefore = G ? SafeReadU8At(G, 0x14) : -1;
+    const bool Spatial = Flags58 >= 0 && (Flags58 & 0x0C) == 0;
+
+    bool Woke = false;
+    if (MpWeaponDormancyFixEnabled() && Spatial && G && DormancyBefore > 1) {
+        Woke = SafeWriteByte(A, 0xF1, 1) && SafeWriteByte(G, 0x14, 0);
+    }
+
+    static std::atomic<int> s_logged{ 0 };
+    if (s_logged.fetch_add(1, std::memory_order_relaxed) >= 32) return;
+    float X = 0, Y = 0, Z = 0;
+    const bool HasLoc = GetActorWorldLocation(Actor, X, Y, Z);
+    char Where[96] = "?";
+    if (HasLoc) {
+        snprintf(Where, sizeof(Where), "(%.0f,%.0f,%.0f)",
+            static_cast<double>(X), static_cast<double>(Y), static_cast<double>(Z));
+    }
+    const char* Route = (Flags58 & 0x08) ? "global" : (Flags58 & 0x04) ? "owner-connection"
+        : (G && SafeReadU8At(G, 0x14) == 1) ? "spatial-static" : "spatial-dynamic";
+    MpLog("[WeaponRoute] actor=" + SafeObjectNameForDiagnostic(Actor)
+        + " owner=" + SafeObjectNameForDiagnostic(reinterpret_cast<void*>(SafeReadPtr(A, 0xE0)))
+        + " graph=" + MpPtr(Graph)
+        + " loc=" + Where
+        + " flags58=" + MpHex(static_cast<uint8_t>(Flags58))
+        + " netDormancy=" + std::to_string(DormancyBefore) + "->" + std::to_string(SafeReadU8At(A, 0xF1))
+        + " wantsDormant=" + std::to_string(WantsBefore) + "->" + std::to_string(G ? SafeReadU8At(G, 0x14) : -1)
+        + " woke=" + std::to_string(Woke ? 1 : 0)
+        + " route=" + Route);
+}
