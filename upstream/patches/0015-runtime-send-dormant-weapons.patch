+// [Dauntless Reforged Revival] Tick-time half of the weapon dormancy fix (see MpRouteWeaponAwake).
+//
+// The route fix covers a weapon that is already dormant when it is registered. A weapon can also be put to
+// sleep later (AActor::SetNetDormancy from its blueprint, for instance while it is still at its spawn
+// point), and the spatial grid then refiles it as a static actor at wherever it is at that moment. So, for
+// each connected player, if the pawn's current weapon wants to be dormant and that player's connection has
+// never replicated it (no actor channel and no replication frame), wake it with the engine's own
+// AActor::SetNetDormancy(DORM_Awake). That goes through UReplicationGraph::NotifyActorDormancyChange, whose
+// DormancyChange event makes the grid move the weapon from its static cells to the dynamic list itself, so
+// no graph state is written by hand. A weapon that was replicated once and then went dormant normally
+// (the city) has a replication frame and is left alone. Each weapon is woken at most once.
+extern void* OrigProcessEvent;
+
+static void MpWakeUnsentPawnWeapons() {
+    if (!Globals::AmServer || Globals::AuthMode != Globals::ServerAuthMode::GlobalGameserver) return;
+    if (!Networking::NetDriver || !OrigProcessEvent) return;
+    if (!MpWeaponDormancyFixEnabled()) return;
+
+    static uint64_t s_nextPollMs = 0;
+    const uint64_t Now = static_cast<uint64_t>(GetTickCount64());
+    if (Now < s_nextPollMs) return;
+    s_nextPollMs = Now + 250;
+
+    const RawPointerArray* Clients = reinterpret_cast<const RawPointerArray*>(
+        reinterpret_cast<uintptr_t>(Networking::NetDriver) + 0x90);
+    if (!IsReadablePointer(Clients, sizeof(RawPointerArray))
+        || !IsSanePointerArray(Clients->Data, Clients->Num, Clients->Max, 1024)) return;
+    void* Graph = reinterpret_cast<void*>(
+        SafeReadPtr(reinterpret_cast<uintptr_t>(Networking::NetDriver), 0x6E8));
+    if (!Graph) return;
+
+    // Keyed on (weapon pointer, UObject InternalIndex at +0x0C), like the other trackers here.
+    struct Woken { uintptr_t Weapon; int32_t Index; };
+    static Woken s_woken[16] = {};
+    static int s_wokenNext = 0;
+    static UFunction* s_setNetDormancyFn = nullptr;
+
+    for (int32_t c = 0; c < Clients->Num; ++c) {
+        void* Conn = Clients->Data[c];
+        if (!Conn || !IsReadablePointer(Conn, 0x98) || !IsRegisteredLiveObject(Conn)) continue;
+        const uintptr_t Pc = SafeReadPtr(reinterpret_cast<uintptr_t>(Conn), 0x30);
+        if (!Pc || !IsReadablePointer(reinterpret_cast<void*>(Pc), 0x420)) continue;
+        const uintptr_t P = SafeReadPtr(Pc, 0x250);
+        if (!P || !IsReadablePointer(reinterpret_cast<void*>(P), 0x748)
+            || !IsRegisteredLiveObject(reinterpret_cast<void*>(P))
+            || !reinterpret_cast<SDK::UObject*>(P)->IsA(SDK::AArchonCharacter::StaticClass())) continue;
+
+        // AArchonCharacter (1.14.7 SDK): Weapon +0x5F0.
+        const uintptr_t W = SafeReadPtr(P, 0x5F0);
+        if (!W || !IsReadablePointer(reinterpret_cast<void*>(W), 0x300)
+            || !IsRegisteredLiveObject(reinterpret_cast<void*>(W))) continue;
+        SDK::UObject* WeaponObj = reinterpret_cast<SDK::UObject*>(W);
+        if (!WeaponObj->IsA(SDK::AArchonWeapon::StaticClass())) continue;
+        if (reinterpret_cast<SDK::AActor*>(W)->bActorIsBeingDestroyed) continue;
+
+        const int32_t Index = SafeReadI32At(W, 0x0C);
+        bool Done = false;
+        for (const Woken& E : s_woken) { if (E.Weapon == W && E.Index == Index) { Done = true; break; } }
+        if (Done) continue;
+
+        void* Global = RepGraphFindGlobalActorInfo(Graph, WeaponObj);
+        if (!Global || !IsReadablePointer(Global, 0x18)) continue;      // not registered with the graph yet
+        const int DormancyBefore = SafeReadU8At(W, 0xF1);
+        const int WantsBefore = SafeReadU8At(reinterpret_cast<uintptr_t>(Global), 0x14);
+        if (DormancyBefore <= 1) continue;                              // awake: nothing to do
+
+        void* Manager = FindRepGraphConnectionManager(Graph, Conn);
+        if (!Manager) continue;
+        void* ConnInfo = RepGraphMapFindValue(
+            reinterpret_cast<uintptr_t>(Manager) + kRepGraphConnActorInfoMap, WeaponObj, 0x20);
+        if (ConnInfo && IsReadablePointer(ConnInfo, 0x30)) {
+            const uintptr_t I = reinterpret_cast<uintptr_t>(ConnInfo);
+            // FConnectionReplicationActorInfo: Channel +0x00, LastRepFrameNum +0x14.
+            if (*reinterpret_cast<void* const*>(I) != nullptr
+                || *reinterpret_cast<const int32_t*>(I + 0x14) != 0) continue;   // already sent
+        }
+
+        if (!s_setNetDormancyFn && WeaponObj->Class) {
+            s_setNetDormancyFn = WeaponObj->Class->GetFunction("Actor", "SetNetDormancy");
+        }
+        s_woken[s_wokenNext] = { W, Index };
+        s_wokenNext = (s_wokenNext + 1) % static_cast<int>(std::size(s_woken));
+        if (s_setNetDormancyFn) {
+            struct { uint8_t NewDormancy; uint8_t Pad[7]; } Params{};
+            Params.NewDormancy = 1;                                     // ENetDormancy::DORM_Awake
+            reinterpret_cast<void(*)(UObject*, UFunction*, void*)>(OrigProcessEvent)(
+                reinterpret_cast<UObject*>(WeaponObj), s_setNetDormancyFn, &Params);
+        }
+        MpLog("[WeaponDormancyWake] weapon=" + SafeObjectNameForDiagnostic(WeaponObj)
+            + " pawn=" + SafeObjectNameForDiagnostic(reinterpret_cast<void*>(P))
+            + " conn=" + MpPtr(Conn)
+            + " netDormancy=" + std::to_string(DormancyBefore) + "->" + std::to_string(SafeReadU8At(W, 0xF1))
+            + " wantsDormant=" + std::to_string(WantsBefore) + "->"
+            + std::to_string(SafeReadU8At(reinterpret_cast<uintptr_t>(Global), 0x14))
+            + " connInfo=" + (ConnInfo ? "unsent" : "none")
+            + " setNetDormancy=" + (s_setNetDormancyFn ? "called" : "NOT FOUND"));
+    }
+}
