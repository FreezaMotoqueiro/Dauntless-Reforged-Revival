diff --git a/ParadoxDirector/src/controllers/trialsRotation.ts b/ParadoxDirector/src/controllers/trialsRotation.ts
new file mode 100644
--- /dev/null
+++ b/ParadoxDirector/src/controllers/trialsRotation.ts
@@ -0,0 +1,13 @@
+// Sunday 2026-10-25 23:59 America/Sao_Paulo (UTC-03:00).
+// Row085 preserves the weekly boundary while advancing the active rotation to 087.
+export const TRIALS_ROTATION_ANCHOR_UNIX = 1792983540;
+export const TRIALS_ROTATION_ANCHOR_ROW = 85;
+export const TRIALS_ROTATION_ROWS = 181;
+export function TrialsRotationAt(nowMs: number, intervalMinutes = 10080) {
+    if (!Number.isFinite(nowMs) || !Number.isSafeInteger(intervalMinutes) || intervalMinutes<1 || intervalMinutes>525600) throw new Error("Invalid Trials rotation time or interval");
+    const period = intervalMinutes*60000;
+    const bucket = Math.floor((nowMs-TRIALS_ROTATION_ANCHOR_UNIX*1000)/period);
+    const week = ((TRIALS_ROTATION_ANCHOR_ROW-1+bucket)%TRIALS_ROTATION_ROWS+TRIALS_ROTATION_ROWS)%TRIALS_ROTATION_ROWS+1;
+    const startMs=TRIALS_ROTATION_ANCHOR_UNIX*1000+bucket*period;
+    return {week,startMs,endMs:startMs+period};
+}
