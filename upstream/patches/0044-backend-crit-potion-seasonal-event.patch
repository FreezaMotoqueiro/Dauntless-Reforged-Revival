diff --git a/ParadoxBackend/src/seasonalEvents.ts b/ParadoxBackend/src/seasonalEvents.ts
new file mode 100644
--- /dev/null
+++ b/ParadoxBackend/src/seasonalEvents.ts
@@ -0,0 +1,18 @@
+// Seasonal items remain usable while their catalog ExpiryEventId is scheduled.
+export function GetSeasonalEventSchedule(value: string | undefined = process.env.SEASONAL_EVENTS) {
+    const ids = [...new Set((value ?? "").split(",").map(id => id.trim()).filter(id => /^[A-Za-z0-9_]{1,64}$/.test(id)))];
+    return {
+        code: null,
+        message: "OK",
+        payload: {
+            ScheduledItems: ids.map(id => ({
+                EndTime: "2099.12.31-23.59.59",
+                IsRepeatable: false,
+                Name: id,
+                RepeatableDetails: { EachDay: false, EachWeek: false },
+                ScheduledItems: [{ ID: id, MaxCompletionPerInterval: -1 }],
+                StartTime: "2020.01.01-00.00.00"
+            }))
+        }
+    };
+}
