diff --git a/ParadoxBackend/src/trainer_service.ts b/ParadoxBackend/src/trainer_service.ts
new file mode 100644
--- /dev/null
+++ b/ParadoxBackend/src/trainer_service.ts
@@ -0,0 +1,129 @@
+// TypeScript; trainer_service.ts; Node.js 20+; Mystic Paradox backend.
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { Router } from 'express';
+import { rateLimit } from 'express-rate-limit';
+
+export type Settings = { xp: number; rewards: number; damage: number; split: boolean };
+type Lease = Settings & { expires: number };
+const NORMAL: Settings = { xp: 1, rewards: 1, damage: 1, split: false };
+const VALID_ID = /^[A-Za-z0-9_-]{1,128}$/;
+const TTL = 15000;
+export function validate(value: unknown): Settings {
+    const v = value as Settings;
+    if (!v || typeof v !== 'object' || Object.keys(v).sort().join(',') !== 'damage,rewards,split,xp') throw new Error('Configuração inválida');
+    for (const [key, max] of [['xp', 1000], ['rewards', 1000], ['damage', 10]] as const) {
+        if (typeof v[key] !== 'number' || !Number.isFinite(v[key]) || v[key] < 1 || v[key] > max) throw new Error(`Limite inválido: ${key}`);
+    }
+    if (typeof v.split !== 'boolean') throw new Error('Divisão inválida');
+    return { xp: v.xp, rewards: v.rewards, damage: v.damage, split: v.split };
+}
+const digest = (s: string) => crypto.createHash('sha256').update(s).digest('hex');
+function canonical(value: any): string {
+    if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+    if (value && typeof value === 'object') return '{' + Object.keys(value).sort().map(k => JSON.stringify(k) + ':' + canonical(value[k])).join(',') + '}';
+    return JSON.stringify(value) ?? 'null';
+}
+
+export class TrainerService {
+    private leases = new Map<string, Lease>();
+    constructor(readonly root: string, private now: () => number = Date.now) {}
+    private policy(): Record<string, string> {
+        if (!this.root) return {};
+        const p = JSON.parse(fs.readFileSync(path.join(this.root, 'access.json'), 'utf8'));
+        if (!p || Array.isArray(p) || typeof p !== 'object' || Object.keys(p).length > 128) throw new Error('access.json inválido');
+        for (const [id, hash] of Object.entries(p)) if (!VALID_ID.test(id) || !/^[a-f0-9]{64}$/.test(String(hash))) throw new Error('Conta/hash inválido');
+        return p;
+    }
+    authenticate(token: string): string | undefined {
+        if (!/^[a-f0-9]{64}$/.test(token)) return;
+        const actual = Buffer.from(digest(token), 'hex');
+        return Object.entries(this.policy()).find(([, h]) => crypto.timingSafeEqual(actual, Buffer.from(h, 'hex')))?.[0];
+    }
+    get(id: string): Settings {
+        const lease = this.leases.get(id);
+        if (!lease || lease.expires <= this.now() || !this.policy()[id]) return { ...NORMAL };
+        return { xp: lease.xp, rewards: lease.rewards, damage: lease.damage, split: lease.split };
+    }
+    active(id: string): boolean {
+        const lease = this.leases.get(id);
+        return !!lease && lease.expires > this.now() && !!this.policy()[id];
+    }
+    set(id: string, raw: unknown) {
+        if (!this.policy()[id]) throw new Error('Conta não autorizada');
+        const value = validate(raw);
+        const lease = { ...value, expires: this.now() + TTL };
+        this.leases.set(id, lease);
+        try { this.snapshot(); } catch (e) { this.leases.delete(id); throw e; }
+        return { account: id, ...lease };
+    }
+    stop(id: string) { this.leases.delete(id); this.snapshot(); }
+    snapshot() {
+        if (!this.root) return;
+        const policy = this.policy();
+        const lines = ['REFORGED_TRAINER_V1'];
+        for (const [id, lease] of this.leases) {
+            if (lease.expires > this.now() && policy[id]) lines.push(`${id} ${lease.expires} ${lease.damage} ${lease.split ? 1 : 0}`);
+            else this.leases.delete(id);
+        }
+        const target = path.join(this.root, 'runtime.txt');
+        const temp = target + '.' + process.pid + '.tmp';
+        fs.writeFileSync(temp, lines.join('\n') + '\n', { mode: 0o600 });
+        fs.renameSync(temp, target);
+    }
+    // Freeze the factor, including 1x, before a persistent grant. Retries retain the
+    // first factor even after the trainer closes, restarts or changes its settings.
+    factor(kind: string, id: string, operation: string, input: unknown, factor: number): number {
+        if (!this.root) return factor;
+        if (!VALID_ID.test(id) || typeof operation !== 'string' || !operation || operation.length > 512) throw new Error('Identidade de transação inválida');
+        const dir = path.join(this.root, 'decisions');
+        fs.mkdirSync(dir, { recursive: true });
+        const file = path.join(dir, digest(JSON.stringify([kind, id, operation])) + '.json');
+        const fingerprint = digest(canonical(input));
+        try {
+            fs.writeFileSync(file, JSON.stringify({ fingerprint, factor }), { flag: 'wx', mode: 0o600, flush: true });
+            return factor;
+        } catch (error: any) {
+            if (error.code !== 'EEXIST') throw error;
+            const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+            if (saved.fingerprint !== fingerprint) throw Object.assign(new Error('Transação reutilizada com conteúdo diferente'), { status: 409 });
+            if (!Number.isFinite(saved.factor) || saved.factor < 1 || saved.factor > (kind === 'weapon_amount' ? 100000000 : 1000)) throw new Error('Decisão persistida inválida');
+            return saved.factor;
+        }
+    }
+}
+
+export const trainer = new TrainerService(process.env.REFORGED_TRAINER_DIR?.trim() ?? '');
+export const trainerRouter = Router();
+trainerRouter.use('/trainer/v1', rateLimit({ windowMs: 60000, limit: 120, standardHeaders: 'draft-7', legacyHeaders: false }));
+trainerRouter.use('/trainer/v1', (req, res, next) => {
+    if (!trainer.root) { res.sendStatus(404); return; }
+    try {
+        const account = trainer.authenticate((req.headers.authorization ?? '').replace(/^Bearer /, ''));
+        if (!account) { res.sendStatus(403); return; }
+        res.locals.trainerAccount = account;
+        res.setHeader('Cache-Control', 'no-store');
+        next();
+    } catch { res.status(503).json({ error: 'Configuração do trainer indisponível' }); }
+});
+trainerRouter.get('/trainer/v1/me', (_req, res) => res.json({ account: res.locals.trainerAccount, ...trainer.get(res.locals.trainerAccount) }));
+trainerRouter.put('/trainer/v1/me', (req, res) => {
+    try { validate(req.body); } catch { res.status(400).json({ error: 'XP/recompensas: 1–1000; dano: 1–10; split: booleano' }); return; }
+    try { res.json(trainer.set(res.locals.trainerAccount, req.body)); }
+    catch { res.status(503).json({ error: 'Não foi possível aplicar a sessão' }); }
+});
+trainerRouter.delete('/trainer/v1/me', (_req, res) => { trainer.stop(res.locals.trainerAccount); res.sendStatus(204); });
+
+export function trainerXp(user: string, grant: string, track: string, amount: number, baseline: number): number {
+    if (!trainer.root || !/^ExperienceTrack_Weapon_(Axe|ChainBlades|Hammer|Repeaters|Sword|Spear|Strikers)$/.test(track)) return baseline;
+    const factor = trainer.get(user).xp;
+    // Freeze the final integer as well as the identity, including normal grants.
+    const selected = !trainer.active(user) ? baseline : Math.min(100000000, Math.floor(amount * factor));
+    return trainer.factor('weapon_amount', user, grant, [track, amount], selected);
+}
+export function trainerRewardFactor(user: string, transaction: string, input: unknown, baseline: number): number {
+    if (!trainer.root) return baseline;
+    const selected = trainer.get(user).rewards;
+    return trainer.factor('rewards', user, transaction, input, trainer.active(user) ? selected : baseline);
+}
diff --git a/ParadoxBackend/src/trainer_service.test.ts b/ParadoxBackend/src/trainer_service.test.ts
