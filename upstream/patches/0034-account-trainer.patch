+++ b/ParadoxBackend/src/trainer_service.test.ts
@@ -0,0 +1,109 @@
+// TypeScript; trainer_service.test.ts; Node.js test runner; isolated temporary data.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import express from 'express';
+import { TrainerService, validate } from './trainer_service';
+import { GrantProgressionXp } from './controllers/progression';
+
+const tokenA = 'a'.repeat(64), tokenB = 'b'.repeat(64);
+const hash = (s: string) => crypto.createHash('sha256').update(s).digest('hex');
+function fixture() {
+    const root = fs.mkdtempSync(path.join(process.cwd(), 'reforged-trainer-test-'));
+    fs.writeFileSync(path.join(root, 'access.json'), JSON.stringify({ alice: hash(tokenA), bob: hash(tokenB) }));
+    let now = 10000;
+    return { root, service: new TrainerService(root, () => now), advance: (n: number) => now += n,
+        cleanup: () => fs.rmSync(root, { recursive: true, force: true }) };
+}
+test('limits reject NaN, infinity, wrong types, extra identity and out-of-range multipliers', () => {
+    const valid = { xp: 1000, rewards: 1000, damage: 10, split: true };
+    assert.deepEqual(validate(valid), valid);
+    for (const patch of [{ xp: NaN }, { damage: Infinity }, { xp: 1001 }, { rewards: 0 }, { damage: 10.01 }, { split: 1 }, { account: 'bob' }, { xp: '2' }]) {
+        assert.throws(() => validate({ ...valid, ...patch }));
+    }
+});
+test('account isolation, expiry and revocation', () => {
+    const f = fixture();
+    try {
+        assert.equal(f.service.authenticate(tokenA), 'alice');
+        assert.equal(f.service.authenticate('c'.repeat(64)), undefined);
+        f.service.set('alice', { xp: 1000, rewards: 700, damage: 10, split: true });
+        assert.equal(f.service.get('alice').xp, 1000);
+        assert.equal(f.service.get('bob').xp, 1);
+        assert.throws(() => f.service.set('mallory', { xp: 2, rewards: 2, damage: 2, split: false }));
+        assert.match(fs.readFileSync(path.join(f.root, 'runtime.txt'), 'utf8'), /alice 25000 10 1/);
+        f.advance(15000);
+        assert.equal(f.service.get('alice').damage, 1);
+        f.service.set('alice', { xp: 2, rewards: 2, damage: 2, split: false });
+        fs.writeFileSync(path.join(f.root, 'access.json'), '{}');
+        assert.equal(f.service.get('alice').xp, 1);
+        f.service.snapshot();
+        assert.equal(fs.readFileSync(path.join(f.root, 'runtime.txt'), 'utf8'), 'REFORGED_TRAINER_V1\n');
+    } finally { f.cleanup(); }
+});
+test('grant factor survives expiry, settings changes and backend restart; conflicting replay rejected', () => {
+    const f = fixture();
+    try {
+        assert.equal(f.service.factor('xp', 'alice', 'grant1', ['weapon', 50], 1000), 1000);
+        assert.equal(f.service.factor('xp', 'alice', 'grant1', ['weapon', 50], 1), 1000);
+        const restarted = new TrainerService(f.root);
+        assert.equal(restarted.factor('xp', 'alice', 'grant1', ['weapon', 50], 2), 1000);
+        assert.throws(() => restarted.factor('xp', 'alice', 'grant1', ['weapon', 51], 2));
+        assert.equal(restarted.factor('xp', 'bob', 'grant1', ['weapon', 50], 1), 1);
+        assert.equal(restarted.factor('rewards', 'alice', 'r1', { a: 1, b: 2 }, 10), 10);
+        assert.equal(restarted.factor('rewards', 'alice', 'r1', { b: 2, a: 1 }, 1), 10);
+    } finally { f.cleanup(); }
+});
+test('1000x weapon XP crosses the old grant cap only through the trusted server path', async () => {
+    let total = 0;
+    const ledger = new Map<string, any>();
+    const repositories: any = {
+        progressionGrants: {
+            findByGrantId: async (id: string) => ledger.get(id),
+            insertApplied: async (record: any) => ledger.set(record.grantId, record),
+        },
+        progressionTracks: {
+            get: async () => ({ progress: total }),
+            increment: async (_user: string, _track: string, amount: number) => ({ progress: total += amount }),
+        },
+    };
+    const unit: any = { withTransaction: async (action: any) => action(repositories, {}) };
+    await assert.rejects(GrantProgressionXp('alice', 'ExperienceTrack_Weapon_Sword', 200000, 'large', unit));
+    const first = await GrantProgressionXp('alice', 'ExperienceTrack_Weapon_Sword', 200000, 'large', unit, 100000000);
+    const repeat = await GrantProgressionXp('alice', 'ExperienceTrack_Weapon_Sword', 200000, 'large', unit, 100000000);
+    assert.equal(first.record.progress, 200000);
+    assert.equal(repeat.replayed, true); assert.equal(total, 200000);
+});
+test('HTTP identity comes from credential, cannot select a second account; stop expires effects', async () => {
+    const f = fixture();
+    // The exported singleton has a disabled root unless explicitly configured.
+    const mod = await import('./trainer_service');
+    Object.defineProperty(mod.trainer, 'root', { value: f.root });
+    const app = express(); app.use(express.json()); app.use(mod.trainerRouter);
+    const server = app.listen(0, '127.0.0.1');
+    await new Promise<void>(resolve => server.once('listening', resolve));
+    const address = server.address() as { port: number };
+    const url = `http://127.0.0.1:${address.port}/trainer/v1/me`;
+    try {
+        assert.equal((await fetch(url)).status, 403);
+        const headers = { Authorization: `Bearer ${tokenA}`, 'Content-Type': 'application/json' };
+        assert.equal((await fetch(url, { method: 'PUT', headers, body: JSON.stringify({ xp: 2, rewards: 3, damage: 4, split: true, account: 'bob' }) })).status, 400);
+        const response = await fetch(url, { method: 'PUT', headers, body: JSON.stringify({ xp: 2, rewards: 3, damage: 4, split: true }) });
+        assert.equal(response.status, 200); assert.equal((await response.json()).account, 'alice');
+        const bob = await fetch(url, { headers: { Authorization: `Bearer ${tokenB}` } });
+        assert.equal((await bob.json()).damage, 1);
+        assert.equal((await fetch(url, { method: 'DELETE', headers })).status, 204);
+        assert.equal((await (await fetch(url, { headers })).json()).damage, 1);
+        assert.equal(mod.trainerXp('alice', 'weapon1000', 'ExperienceTrack_Weapon_Sword', 200, 200), 200);
+        mod.trainer.set('alice', { xp: 1000, rewards: 1000, damage: 10, split: true });
+        assert.equal(mod.trainerXp('alice', 'weapon1001', 'ExperienceTrack_Weapon_Sword', 200, 200), 200000);
+        assert.equal(mod.trainerXp('bob', 'weapon1002', 'ExperienceTrack_Weapon_Sword', 200, 200), 200);
+        assert.equal(mod.trainerXp('alice', 'slayer1001', 'ExperienceTrack_Slayer', 200, 200), 200);
+        assert.equal(mod.trainerXp('alice', 'weapon1000', 'ExperienceTrack_Weapon_Sword', 200, 200), 200);
+    } finally {
+        await new Promise<void>(resolve => server.close(() => resolve())); f.cleanup();
+    }
+});
