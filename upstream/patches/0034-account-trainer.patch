+++ b/ParadoxRuntime/TrainerRuntime.inl
@@ -0,0 +1,238 @@
+// C++20; TrainerRuntime.inl; Windows x64/MSVC; Dauntless 1.14.7 dedicated runtime.
+// Included by dllmain.cpp before InitServerHooks, after the existing SDK/helpers.
+#include <fstream>
+#include <sstream>
+#include <unordered_map>
+#include <chrono>
+#include <cmath>
+#include "TrainerBuild.generated.h"
+
+namespace AccountTrainer {
+using namespace SDK;
+using ApplyFn = void(*)(const FArchonDamageCalculation&, const FArchonDamageResult&,
+    const FArchonAbilityDamageEvent&, const FDamageExecutionTelemetryData&);
+using NormalFn = void(*)(const FArchonDamageCalculation&, const FArchonAbilityDamageEvent&, float);
+static ApplyFn original_apply = nullptr;
+static NormalFn original_normal = nullptr;
+struct Lease { uint64_t expires{}; float damage = 1; bool split = false; };
+static std::unordered_map<std::string, Lease> leases;
+static uint64_t next_read = 0;
+static std::string state_dir;
+static std::mutex state_mutex;
+static uint64_t now_ms() {
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count());
+}
+static Lease settings(const std::string& id) {
+    std::lock_guard<std::mutex> lock(state_mutex);
+    const auto now = now_ms();
+    if (now >= next_read) {
+        next_read = now + 250;
+        leases.clear();
+        std::ifstream file(state_dir + "\\runtime.txt");
+        std::string line;
+        if (std::getline(file, line) && line == "REFORGED_TRAINER_V1") {
+            for (int n = 0; n < 128 && std::getline(file, line); ++n) {
+                if (line.size() > 256) break;
+                std::istringstream row(line); std::string user, extra; Lease value; int split;
+                if (!(row >> user >> value.expires >> value.damage >> split) || row >> extra) continue;
+                if (user.size() > 128 || user.find_first_not_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-") != std::string::npos) continue;
+                if (value.expires <= now || value.expires > now + 16000 || !std::isfinite(value.damage)
+                    || value.damage < 1 || value.damage > 10 || (split != 0 && split != 1)) continue;
+                value.split = split == 1; leases.emplace(user, value);
+            }
+        }
+    }
+    auto it = leases.find(id);
+    return it != leases.end() && it->second.expires > now ? it->second : Lease{};
+}
+static void engine_free(void* ptr) {
+    if (ptr) reinterpret_cast<void(*)(void*)>(Globals::BaseAddress + TrainerBuild::free_rva)(ptr);
+}
+template<class T> struct OwnedArray {
+    TArray<T> value;
+    ~OwnedArray() { engine_free(const_cast<T*>(value.GetDataPtr())); }
+};
+static bool live(UObject* object) {
+    return object && IsReadablePointer(object, sizeof(UObject)) && IsRegisteredLiveObject(object);
+}
+// Identity is obtained from the server's player state, never a submitted player name.
+static std::string account(AActor* source) {
+    if (!live(source)) return {};
+    AController* controller = source->GetInstigatorController();
+    if (!controller && source->IsA(APawn::StaticClass())) controller = static_cast<APawn*>(source)->Controller;
+    if (!live(controller) || !controller->IsA(APlayerController::StaticClass())) return {};
+    auto* pc = static_cast<APlayerController*>(controller);
+    if (!live(pc->PlayerState) || !pc->NetConnection) return {}; // excludes the synthetic hub player
+    auto* slot = reinterpret_cast<uint8_t*>(&pc->PlayerState->UniqueId);
+    if (!IsReadablePointer(slot, 24)) return {};
+    void* net_id = *reinterpret_cast<void**>(slot + 8);
+    if (!IsReadablePointer(net_id, sizeof(void*))) return {};
+    auto** table = *reinterpret_cast<void***>(net_id);
+    if (!IsReadablePointer(table, 0x38)) return {};
+    if (!reinterpret_cast<bool(*)(void*)>(table[5])(net_id)) return {};
+    FString value{};
+    reinterpret_cast<void*(*)(void*, FString*)>(table[6])(net_id, &value);
+    const auto id = CoreCapFString(&value);
+    engine_free(value.CStr());
+    if (id.empty() || id.size() > 128 || id == "INVALID") return {};
+    return id;
+}
+static bool weak_component(UPrimitiveComponent* object, TWeakObjectPtr<UPrimitiveComponent>& weak) {
+    if (!live(object)) return false;
+    const auto index = object->Index;
+    auto* array = UObject::GObjects.operator->();
+    if (index < 0 || index >= array->Num()) return false;
+    auto* item = &array->GetDecrytedObjPtr()[index / 65536][index % 65536];
+    if (!IsReadablePointer(item, 24) || item->Object != object) return false;
+    // FUObjectItem serial offset verified by the native weak resolver in this build.
+    const auto serial = *reinterpret_cast<const int32_t*>(reinterpret_cast<const uint8_t*>(item) + 16);
+    if (serial <= 0 || ResolveWeakObj(index, serial) != object) return false;
+    weak.ObjectIndex = index; weak.ObjectSerialNumber = serial;
+    return true;
+}
+struct Part { UMonsterPartComponent* part; TWeakObjectPtr<UPrimitiveComponent> collision; FName bone; };
+static std::vector<Part> parts(AArchonBehemoth* target) {
+    std::vector<Part> out;
+    OwnedArray<UActorComponent*> all_parts{target->K2_GetComponentsByClass(UMonsterPartComponent::StaticClass())};
+    OwnedArray<UActorComponent*> shapes{target->K2_GetComponentsByClass(UShapeComponent::StaticClass())};
+    if (all_parts.value.Num() > 64 || shapes.value.Num() > 2048) return out;
+    for (auto* object : all_parts.value) {
+        if (!live(object)) continue;
+        auto* part = static_cast<UMonsterPartComponent*>(object);
+        if (!part->CanBeBroken() || part->IsBroken() || part->GetCurrentHealth() <= 0) continue;
+        bool found = false;
+        for (auto* shape : shapes.value) {
+            if (!live(shape)) continue;
+            auto* primitive = static_cast<UShapeComponent*>(shape);
+            if (!part->ContainsComponent(primitive)) continue;
+            Part candidate{part, {}, part->PhATBones.Num() > 0 ? part->PhATBones[0] : FName{}};
+            if (weak_component(primitive, candidate.collision)) { out.push_back(candidate); found = true; break; }
+        }
+        // Skeletal collision uses PhAT bones rather than separate shape components.
+        if (!found && live(target->Mesh) && part->PhATBones.Num() <= 128) {
+            for (const auto& bone : part->PhATBones) {
+                OwnedArray<UMonsterPartComponent*> mapped{target->GetPartsForBone(bone, false)};
+                if (mapped.value.Num() != 1 || mapped.value[0] != part) continue;
+                Part candidate{part, {}, bone};
+                if (weak_component(target->Mesh, candidate.collision)) {
+                    out.push_back(candidate); found = true; break;
+                }
+            }
+        }
+        // Never silently spread across only a subset of eligible parts.
+        if (!found) return {};
+    }
+    return out;
+}
+static void scale_info(FArchonAbilityDamageInfo& d, float factor) {
+    d.BaseDamage *= factor; d.RawDamage *= factor;
+    d.TotalElementalDamage *= factor; d.TotalPhysicalDamage *= factor; d.TotalDamageApplied *= factor;
+    d.Payload.EventMagnitude *= factor;
+    d.MitigatedDamage.PhysicalDamage *= factor; d.MitigatedDamage.FlameDamage *= factor;
+    d.MitigatedDamage.FrostDamage *= factor; d.MitigatedDamage.ShockDamage *= factor;
+    d.MitigatedDamage.RadiantDamage *= factor; d.MitigatedDamage.UmbralDamage *= factor;
+    d.MitigatedDamage.TerraDamage *= factor; d.MitigatedDamage.RawElementalDamage *= factor;
+}
+struct Context { const FArchonDamageCalculation* calculation; std::vector<Part> parts; Context* previous; };
+static thread_local Context* context = nullptr;
+static void normal_hook(const FArchonDamageCalculation& c, const FArchonAbilityDamageEvent& event, float amount) {
+    auto* active = context;
+    if (!active || active->calculation != &c || active->parts.empty() || !std::isfinite(amount) || amount <= 0) {
+        original_normal(c, event, amount); return;
+    }
+    const auto& handle = event.DamageInfo.Payload.ContextHandle;
+    if (!UAbilitySystemBlueprintLibrary::EffectContextHasHitResult(handle)) {
+        original_normal(c, event, amount); return;
+    }
+    const auto saved_hit = UAbilitySystemBlueprintLibrary::EffectContextGetHitResult(handle);
+    // The native setter mutates the shared context; restore after synchronous dispatch.
+    struct RestoreHit {
+        const FGameplayEffectContextHandle& handle; FHitResult hit;
+        ~RestoreHit() { UAbilitySystemBlueprintLibrary::EffectContextAddHitResult(handle, hit, true); }
+    } restore_hit{handle, saved_hit};
+    // Remove this context during dispatch: secondary attacks are independent hits.
+    context = active->previous;
+    struct Restore { Context* value; ~Restore() { context = value; } } restore{active};
+    const float count = static_cast<float>(active->parts.size());
+    float remaining = amount;
+    for (size_t i = 0; i < active->parts.size(); ++i) {
+        const auto& part = active->parts[i];
+        const float share = i + 1 == active->parts.size() ? remaining : amount / count;
+        remaining -= share;
+        auto copy = c; auto damage = event;
+        copy.Request.bHasHitInfo = true;
+        copy.Request.HitInfo.Component = part.collision;
+        copy.Request.HitInfo.BoneName = part.bone;
+        damage.Component = part.collision;
+        scale_info(damage.DamageInfo, share / amount);
+        auto hit = saved_hit;
+        hit.Component = part.collision; hit.BoneName = part.bone;
+        copy.Request.HitInfo = hit;
+        UAbilitySystemBlueprintLibrary::EffectContextAddHitResult(handle, hit, true);
+        original_normal(copy, damage, share);
+    }
+}
+static void apply_hook(const FArchonDamageCalculation& c, const FArchonDamageResult& r,
+    const FArchonAbilityDamageEvent& event, const FDamageExecutionTelemetryData& telemetry) {
+    if (!Globals::AmServer || !live(c.Request.TargetActor) || !c.Request.TargetActor->IsA(AArchonBehemoth::StaticClass())) {
+        original_apply(c, r, event, telemetry); return;
+    }
+    const auto id = account(c.Request.SourceActor);
+    const auto selected = id.empty() ? Lease{} : settings(id);
+    if (selected.damage == 1 && !selected.split) { original_apply(c, r, event, telemetry); return; }
+    if (!std::isfinite(r.ActualDamageApplied) || r.ActualDamageApplied < 0 || r.ActualDamageApplied > 1e20f) {
+        original_apply(c, r, event, telemetry); return;
+    }
+    auto result = r; auto damage = event;
+    const float factor = selected.damage;
+    // Copy array storage before scaling: SDK TArrays are non-owning shallow wrappers.
+    std::vector<float> pre, post;
+    if (r.PreMitigationDamages.Values.Num() < 0 || r.PreMitigationDamages.Values.Num() > 32
+        || r.PostMitigationDamages.Values.Num() < 0 || r.PostMitigationDamages.Values.Num() > 32) {
+        original_apply(c, r, event, telemetry); return;
+    }
+    for (float v : r.PreMitigationDamages.Values) pre.push_back(v * factor);
+    for (float v : r.PostMitigationDamages.Values) post.push_back(v * factor);
+    result.PreMitigationDamages.Values = TArray<float>(pre.data(), static_cast<int>(pre.size()), static_cast<int>(pre.size()));
+    result.PostMitigationDamages.Values = TArray<float>(post.data(), static_cast<int>(post.size()), static_cast<int>(post.size()));
+    result.RawBaseDamage *= factor; result.BaseDamageWithMultipliersApplied *= factor;
+    result.FinalStaggerDamage *= factor; result.FinalExposeDamage *= factor;
+    result.UncappedDamage *= factor; result.UncappedPhysicalDamage *= factor; result.UncappedElementalDamage *= factor;
+    result.ActualDamageApplied *= factor; result.VsBehemoth_CoreDamageFromBP *= factor;
+    result.DamageGameplayEventData.EventMagnitude *= factor;
+    scale_info(damage.DamageInfo, factor);
+    Context local{&c, selected.split ? parts(static_cast<AArchonBehemoth*>(c.Request.TargetActor)) : std::vector<Part>{}, context};
+    context = &local;
+    struct Restore { Context* value; ~Restore() { context = value; } } restore{local.previous};
+    static unsigned reported = 0;
+    if (reported++ < 64) MpLog("[AccountTrainer] account=" + id + " damage=" + std::to_string(factor)
+        + " parts=" + std::to_string(local.parts.size()) + " input=" + std::to_string(r.ActualDamageApplied)
+        + " output=" + std::to_string(result.ActualDamageApplied));
+    original_apply(c, result, damage, telemetry);
+}
+static void install() {
+    if (!Globals::AmServer || !MpReadEnvironment("REFORGED_TRAINER_DIR", state_dir, 1024) || state_dir.empty()) return;
+    auto* base = reinterpret_cast<uint8_t*>(Globals::BaseAddress);
+    auto* dos = reinterpret_cast<IMAGE_DOS_HEADER*>(base);
+    auto* nt = reinterpret_cast<IMAGE_NT_HEADERS64*>(base + dos->e_lfanew);
+    if (nt->FileHeader.TimeDateStamp != TrainerBuild::timestamp || nt->OptionalHeader.SizeOfImage != TrainerBuild::image_size
+        || memcmp(base + TrainerBuild::apply_rva, TrainerBuild::apply_bytes, sizeof(TrainerBuild::apply_bytes))
+        || memcmp(base + TrainerBuild::normal_rva, TrainerBuild::normal_bytes, sizeof(TrainerBuild::normal_bytes))
+        || memcmp(base + TrainerBuild::free_rva, TrainerBuild::free_bytes, sizeof(TrainerBuild::free_bytes))) {
+        MpLog("[AccountTrainer] DISABLED: executable signature mismatch"); return;
+    }
+    if (MH_CreateHook(base + TrainerBuild::apply_rva, &apply_hook, reinterpret_cast<void**>(&original_apply)) != MH_OK) {
+        MpLog("[AccountTrainer] DISABLED: apply hook failed"); return;
+    }
+    if (MH_CreateHook(base + TrainerBuild::normal_rva, &normal_hook, reinterpret_cast<void**>(&original_normal)) != MH_OK) {
+        MH_RemoveHook(base + TrainerBuild::apply_rva);
+        MpLog("[AccountTrainer] DISABLED: split hook failed"); return;
+    }
+    if (MH_EnableHook(base + TrainerBuild::normal_rva) != MH_OK || MH_EnableHook(base + TrainerBuild::apply_rva) != MH_OK) {
+        MH_DisableHook(base + TrainerBuild::apply_rva); MH_DisableHook(base + TrainerBuild::normal_rva);
+        MpLog("[AccountTrainer] DISABLED: hook activation failed"); return;
+    }
+    MpLog("[AccountTrainer] per-account damage integration installed");
+}
+}
