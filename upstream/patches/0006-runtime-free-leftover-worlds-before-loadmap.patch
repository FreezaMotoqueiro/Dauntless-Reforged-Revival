+// ============================================================================
+// [Dauntless Reforged Revival] The travel crash: a client that leaves a hunt (back to Ramsgate, or into a second
+// hunt) crashes in UEngine::LoadMap (0x04271370) at 0x04272D28, reading the new world's null PersistentLevel
+// through GetOutermost (0x0285E6F0, "EXCEPTION_ACCESS_VIOLATION reading address 0x20").
+//
+// Ported from Mystic Paradox's fix of 10 Oct 2026 (upstream commit c7869b6, MpReleaseZombieKeepFlags). Its root
+// cause, from the upstream analysis: a map's previous UWorld survives the trip. One input component
+// (default_input_bpc_C), pending kill, keeps GUObjectArray's Async item flag (0x04000000, one of the GC keep flags);
+// 1.14.7's mark phase keeps such an object even when it is PendingKill, and GC never eliminates Outer references,
+// so it keeps its PlayerController, PersistentLevel, UWorld and package alive. GC destroys the level and nulls
+// PersistentLevel, but the world stays; when the client travels to that map again, LoadMap's FindPackage finds it
+// in memory and reuses it.
+//
+// The fix runs at the entry of LoadMap, before LoadMap's own full-purge CollectGarbage (called at 0x042721A6 with
+// KeepFlags 0, after the old world is detached and before FindPackage): it clears the stale Async bit on the objects
+// inside leftover worlds (pending-kill UWorlds other than GWorld), so the purge frees them and LoadMap loads the map
+// fresh. Touched: only objects that are PendingKill, not RootSet, and carry Async without AsyncLoading, and whose
+// Outer chain reaches a leftover world; only the Async bit. KEEP_STUCK_ASYNC_FLAGS.flag beside the game executable
+// turns it into a report only.
+// ============================================================================
+static constexpr uintptr_t kRrEngineLoadMapRva = 0x04271370;
+static const uint8_t kRrEngineLoadMapBytes[] = {
+    0x48, 0x89, 0x5C, 0x24, 0x20,                  // mov [rsp+0x20], rbx
+    0x55, 0x56, 0x57, 0x41, 0x54, 0x41, 0x55,      // push rbp / rsi / rdi / r12 / r13
+    0x41, 0x56, 0x41, 0x57,                        // push r14 / r15
+    0x48, 0x8D, 0xAC, 0x24, 0x00, 0xFE, 0xFF, 0xFF,// lea rbp, [rsp-0x200]
+    0x48, 0x81, 0xEC, 0x00, 0x03, 0x00, 0x00,      // sub rsp, 0x300
+};
+using RrEngineLoadMapFn = bool(__fastcall*)(void* Engine, void* WorldContext, void* Url, void* Pending, void* Error);
+static RrEngineLoadMapFn OrigRrEngineLoadMap = nullptr;
+
+// GUObjectArray item flags (UE 4.26).
+static constexpr int32_t kRrItemRootSet = 0x40000000;
+static constexpr int32_t kRrItemPendingKill = 0x20000000;
+static constexpr int32_t kRrItemAsyncLoading = 0x08000000;
+static constexpr int32_t kRrItemAsync = 0x04000000;
+
+struct RrStuckAsyncResult {
+    int LeftoverWorlds;
+    int Released;     // objects whose Async bit was cleared (or would be, in report-only mode)
+    int LeftAlone;    // objects inside a leftover world with another keep flag (RootSet, AsyncLoading)
+    bool Faulted;
+};
+
+// POD-only: runs inside __try. Release = clear the Async bit on the eligible objects.
+static RrStuckAsyncResult RrReleaseStuckAsyncFlags(bool Release) {
+    RrStuckAsyncResult R{ 0, 0, 0, false };
+    void* Worlds[64];
+    int NumWorlds = 0;
+    __try {
+        SDK::TUObjectArray* Arr = SDK::UObject::GObjects.operator->();
+        const int Count = Arr ? Arr->NumElements : 0;
+        SDK::UClass* WorldClass = SDK::UWorld::StaticClass();
+        void* Current = *reinterpret_cast<void**>(Globals::BaseAddress + 0x06FC7F58);   // GWorld
+        // 1. The leftover worlds: pending-kill UWorlds that are not the current world.
+        for (int i = 0; i < Count && NumWorlds < 64; ++i) {
+            SDK::FUObjectItem* Chunk = Arr->Objects[i / SDK::TUObjectArray::ElementsPerChunk];
+            if (!Chunk) continue;
+            SDK::FUObjectItem* Item = &Chunk[i % SDK::TUObjectArray::ElementsPerChunk];
+            SDK::UObject* Obj = Item->Object;
+            if (!Obj || !Obj->Class || Obj == Current) continue;
+            const uint32_t ObjFlags = *reinterpret_cast<uint32_t*>(reinterpret_cast<uintptr_t>(Obj) + 0x08);
+            if (ObjFlags & 0x10) continue;                   // RF_ClassDefaultObject
+            const int32_t ItemFlags = *reinterpret_cast<int32_t*>(reinterpret_cast<uintptr_t>(Item) + 0x08);
+            if (!(ItemFlags & kRrItemPendingKill)) continue;
+            if (!Obj->IsA(WorldClass)) continue;
+            Worlds[NumWorlds++] = Obj;
+        }
+        R.LeftoverWorlds = NumWorlds;
+        if (NumWorlds == 0) return R;
+        // 2. The objects inside them that a stale Async bit keeps alive.
+        for (int i = 0; i < Count; ++i) {
+            SDK::FUObjectItem* Chunk = Arr->Objects[i / SDK::TUObjectArray::ElementsPerChunk];
+            if (!Chunk) continue;
+            SDK::FUObjectItem* Item = &Chunk[i % SDK::TUObjectArray::ElementsPerChunk];
+            void* Obj = Item->Object;
+            if (!Obj) continue;
+            volatile LONG* Flags = reinterpret_cast<volatile LONG*>(reinterpret_cast<uintptr_t>(Item) + 0x08);
+            const LONG F = *Flags;
+            if (!(F & (kRrItemRootSet | kRrItemAsyncLoading | kRrItemAsync))) continue;
+            bool Inside = false;
+            void* O = Obj;
+            for (int Depth = 0; O && Depth < 17 && !Inside; ++Depth) {
+                for (int w = 0; w < NumWorlds; ++w) if (Worlds[w] == O) { Inside = true; break; }
+                O = *reinterpret_cast<void**>(reinterpret_cast<uintptr_t>(O) + 0x20);   // UObject::Outer
+            }
+            if (!Inside) continue;
+            const bool Eligible = (F & kRrItemPendingKill) && !(F & kRrItemRootSet) && (F & kRrItemAsync) && !(F & kRrItemAsyncLoading);
+            if (!Eligible) { ++R.LeftAlone; continue; }
+            if (Release) InterlockedAnd(Flags, ~static_cast<LONG>(kRrItemAsync));
+            ++R.Released;
+        }
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER) {
+        R.Faulted = true;
+    }
+    return R;
+}
+
+static bool __fastcall RrEngineLoadMapDetour(void* Engine, void* WorldContext, void* Url, void* Pending, void* Error) {
+    if (MpProcessDetaching()) return OrigRrEngineLoadMap(Engine, WorldContext, Url, Pending, Error);
+    static int s_reportOnly = -1;
+    if (s_reportOnly < 0) s_reportOnly = MpExeRelativeFlagPresent(L"KEEP_STUCK_ASYNC_FLAGS.flag") ? 1 : 0;
+    const RrStuckAsyncResult R = RrReleaseStuckAsyncFlags(!s_reportOnly);
+    if (R.LeftoverWorlds > 0 || R.Faulted) {
+        MpLog(std::string("[ZombieWorld] LoadMap: ") + std::to_string(R.LeftoverWorlds) + " leftover world(s), "
+            + std::to_string(R.Released) + " object(s) with a stale Async keep flag "
+            + (s_reportOnly ? "found (KEEP_STUCK_ASYNC_FLAGS.flag: not released)" : "released, so LoadMap's purge frees them")
+            + (R.LeftAlone ? ", " + std::to_string(R.LeftAlone) + " left alone (RootSet or AsyncLoading)" : std::string())
+            + (R.Faulted ? " (scan faulted)" : ""));
+    }
+    return OrigRrEngineLoadMap(Engine, WorldContext, Url, Pending, Error);
+}
+
+static void RrInstallTravelCrashFix() {
+    if (Globals::AmServer) return;
+    const CwSite S{ "UEngine::LoadMap", kRrEngineLoadMapRva, kRrEngineLoadMapBytes, sizeof(kRrEngineLoadMapBytes), 0, 0,
+        reinterpret_cast<void*>(&RrEngineLoadMapDetour), reinterpret_cast<void**>(&OrigRrEngineLoadMap) };
+    if (const char* Why = CwVerifySite(S)) {
+        MpLog(std::string("[ZombieWorld] travel-crash fix NOT installed rva=+") + MpHex(S.Rva) + " reason=" + Why);
+        return;
+    }
+    void* Target = reinterpret_cast<void*>(Globals::BaseAddress + S.Rva);
+    const MH_STATUS C = MH_CreateHook(Target, S.Detour, S.Orig);
+    const MH_STATUS E = C == MH_OK ? MH_EnableHook(Target) : C;
+    if (C == MH_OK && E != MH_OK) MH_RemoveHook(Target);
+    MpLog(std::string("[ZombieWorld] travel-crash fix install rva=+") + MpHex(S.Rva) + " create=" + MH_StatusToString(C)
+        + " enable=" + MH_StatusToString(E)
+        + (MpExeRelativeFlagPresent(L"KEEP_STUCK_ASYNC_FLAGS.flag") ? " (KEEP_STUCK_ASYNC_FLAGS.flag: report only)" : ""));
+}
+
 // Expected entry bytes, verified on the installed 1.14.7 exe (design review, 8 Oct). Parent calls are checked as
 // entry + offset so no new mid-function RVA literal appears in the source.
 static const uint8_t kCwBytesRefreshKeys[] = { 0x40,0x53,0x57,0x41,0x57,0x48,0x83,0xEC,0x70,0x4C,0x8B,0xF9,0x48,0x8B,0x89,0x88,0x03,0x00,0x00 };
