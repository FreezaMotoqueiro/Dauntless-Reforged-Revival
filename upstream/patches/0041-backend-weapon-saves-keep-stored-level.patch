diff --git a/ParadoxBackend/src/weaponBaseLevel.ts b/ParadoxBackend/src/weaponBaseLevel.ts
index e3ed71b..960d623 100644
--- a/ParadoxBackend/src/weaponBaseLevel.ts
+++ b/ParadoxBackend/src/weaponBaseLevel.ts
@@ -59,3 +59,30 @@ export function ServeWeaponsAtBaseLevel<T>(value: T, depth: number = 0): T {
     }
     return (Out ?? value) as T;
 }
+
+// [Reforged 0041] A weapon save never lowers the stored level while weapons are served at level 0.
+//
+// The game saves itemData back as it holds it, and since 0036 it holds CurrentLevel 0. Without this,
+// the next save of an upgraded weapon (equipping a cell, a part, ...) wrote level 0 over the stored
+// one and the Aether Heart upgrades were lost for good. Here the saved level is the higher of the
+// stored and the incoming one: a real upgrade still raises it, a save of the served 0 keeps it.
+// Anything else (not a weapon, no stored level, unparsable data, KEEP_WEAPON_ITEM_LEVELS=true)
+// is saved as sent.
+function ParsedLevel(itemData: unknown): { parsed: any; level: number } | undefined {
+    if (typeof itemData !== "string" || !itemData.includes("CurrentLevel")) return undefined;
+    let Parsed: any;
+    try { Parsed = JSON.parse(itemData); } catch { return undefined; }
+    if (Parsed == null || typeof Parsed !== "object" || Array.isArray(Parsed)) return undefined;
+    if (typeof Parsed.CurrentLevel !== "number") return undefined;
+    return { parsed: Parsed, level: Parsed.CurrentLevel };
+}
+
+export function KeepStoredWeaponLevel(catalogId: unknown, storedItemData: unknown, incomingItemData: unknown): unknown {
+    if (KeepWeaponItemLevels()) return incomingItemData;
+    if (typeof catalogId !== "string" || !catalogId.startsWith("WP_")) return incomingItemData;
+    const Stored = ParsedLevel(storedItemData);
+    if (Stored === undefined || Stored.level <= 0) return incomingItemData;
+    const Incoming = ParsedLevel(incomingItemData);
+    if (Incoming === undefined || Incoming.level >= Stored.level) return incomingItemData;
+    return JSON.stringify({ ...Incoming.parsed, CurrentLevel: Stored.level });
+}
