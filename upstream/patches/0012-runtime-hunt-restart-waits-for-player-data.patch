+// [Dauntless Reforged Revival] A hunt must not restart a player before that player's own data has loaded.
+// The PlayerCanRestart force above answers true for every controller, so any restart request spawns the pawn
+// at once. Usually nothing asks until OnPlayerDataLoadComplete (which calls ServerRestartPlayer itself), but
+// in some hunts another progression component finishes loading first and the connecting player is
+// restarted long before their own load ends: about 1.5 s after joining since the progression configuration is
+// queried at boot, 20-30 s before that (16 Oct, Snow Jen: joined 19:07:36.7, restarted 19:07:38.0; the same
+// order at 18:36:40 and 18:38:19). The character then reaches the client with
+// no weapon or armour, the client's readiness never turns true, and the client crashed in the HUD as soon as
+// its readiness was forced. Hold the restart until OnPlayerDataLoadComplete has run for that controller: that
+// is the order every other hunt already follows, including the ones whose load needs the 60 s LoadFailed retry
+// ("[PlayerDataRecovery] completed after retry", then ClientRestart 0.1-0.6 s later). After 90 s the old
+// behaviour returns, so a player is never held forever. Hunts only: the city and the Training Grounds keep the
+// old behaviour. DISABLE_RESTART_DATA_GATE.flag turns the gate off.
+struct MpPlayerDataGateEntry {
+    uintptr_t Controller;
+    uint64_t FirstHeldMs;
+    bool Loaded;
+};
+static MpPlayerDataGateEntry s_PlayerDataGate[32] = {};
+static uint32_t s_PlayerDataGateNext = 0;
+static constexpr uint64_t kRestartHoldFallbackMs = 90000;
+
+static MpPlayerDataGateEntry* MpPlayerDataGateEntryFor(uintptr_t Controller) {
+    for (MpPlayerDataGateEntry& E : s_PlayerDataGate) {
+        if (E.Controller == Controller) return &E;
+    }
+    MpPlayerDataGateEntry& E = s_PlayerDataGate[s_PlayerDataGateNext++ % 32];
+    E = { Controller, 0, false };
+    return &E;
+}
+
+static void MpMarkPlayerDataLoaded(uintptr_t Controller) {
+    if (!Globals::AmServer || !Controller) return;
+    MpPlayerDataGateEntryFor(Controller)->Loaded = true;
+}
+
+static bool MpHoldRestartUntilPlayerDataLoaded(void* Controller) {
+    if (!Globals::AmServer || Globals::AuthMode != Globals::ServerAuthMode::GlobalGameserver) return false;
+    if (g_wdIsHub.load(std::memory_order_relaxed) != 0) return false;   // hunts only (hubs, unknown: old path)
+    static int s_disabled = -1;
+    if (s_disabled < 0) s_disabled = MpExeRelativeFlagPresent(L"DISABLE_RESTART_DATA_GATE.flag") ? 1 : 0;
+    if (s_disabled == 1) return false;
+    if (!Controller || !IsReadablePointer(Controller, 0x420) || !IsRegisteredLiveObject(Controller)) return false;
+    const uintptr_t P = reinterpret_cast<uintptr_t>(Controller);
+    if (SafeReadPtr(P, 0x418) == 0) return false;                       // only connected (remote) players
+
+    MpPlayerDataGateEntry* E = MpPlayerDataGateEntryFor(P);
+    if (E->Loaded) return false;
+    const uint64_t Now = GetTickCount64();
+    if (E->FirstHeldMs == 0) {
+        E->FirstHeldMs = Now;
+        MpLog("[RestartDataGate] holding restart until player data loads: controller=" + MpPtr(Controller));
+    }
+    if (Now - E->FirstHeldMs >= kRestartHoldFallbackMs) {
+        E->Loaded = true;
+        MpLog("[RestartDataGate] player data still not loaded after 90 s; allowing restart: controller="
+            + MpPtr(Controller));
+        return false;
+    }
+    return true;
+}
