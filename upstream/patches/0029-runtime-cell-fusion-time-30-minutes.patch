+// [Dauntless Reforged Revival] The Middleman's cell fusion time. Each fusion recipe's TimeRequired comes from the
+// game's cell exchange data table (UDataTable with row struct CellExchangeTableData, held by
+// UArchonGameInstance::CellExchangeTable): the game server builds a started fusion's end time from it
+// (UArchonInventory::ExchangeCells) and the client shows it on the Middleman's screen
+// (GetExchangeCellResultInfo). This sets every recipe to CELL_FUSION_MINUTES (default 30) in memory, in the client
+// and the game servers, from the game thread (the ProcessEvent hooks): every 2 seconds until the table is found,
+// then every 30 seconds. Same approach as Dauntless Revived's CellFusionTime.h. CELL_FUSION_MINUTES=0 or
+// KEEP_CELL_FUSION_TIME.flag beside the game executable keeps the game's own times. Fusions started before the
+// change keep the end time they were given.
+static int64_t MpCellFusionTicks() {
+    constexpr int64_t kTicksPerMinute = 600000000LL;   // FTimespan ticks are 100 ns
+    long Minutes = 30;
+    char Value[16] = {};
+    const DWORD n = GetEnvironmentVariableA("CELL_FUSION_MINUTES", Value, static_cast<DWORD>(sizeof(Value)));
+    if (n > 0 && n < sizeof(Value)) {
+        char* End = nullptr;
+        const long Parsed = std::strtol(Value, &End, 10);
+        if (End != Value && *End == '\0' && Parsed >= 0 && Parsed <= 7 * 24 * 60) Minutes = Parsed;
+    }
+    return static_cast<int64_t>(Minutes) * kTicksPerMinute;
+}
+
+static void MpSetCellFusionTime() {
+    static ULONGLONG s_next = 0;
+    static UObject* s_table = nullptr;
+    static int64_t s_ticks = -1;
+    const ULONGLONG Now = GetTickCount64();
+    if (Now < s_next) return;
+    s_next = Now + (s_table ? 30000 : 2000);
+    if (s_ticks < 0) {
+        s_ticks = MpExeRelativeFlagPresent(L"KEEP_CELL_FUSION_TIME.flag") ? 0 : MpCellFusionTicks();
+        if (s_ticks == 0) MpLog("[CellFusion] the game's own cell fusion times are kept");
+    }
+    if (s_ticks == 0 || !UObject::GObjects) return;
+
+    if (!s_table || !IsRegisteredLiveObject(s_table)) {
+        s_table = nullptr;
+        UClass* Cls = SDK::UDataTable::StaticClass();
+        if (!Cls) return;
+        const int Count = UObject::GObjects->Num();
+        for (int i = 0; i < Count; ++i) {
+            UObject* Obj = UObject::GObjects->GetByIndex(i);
+            if (!Obj || Obj->IsDefaultObject() || !Obj->IsA(Cls)) continue;
+            SDK::UScriptStruct* RowStruct = static_cast<SDK::UDataTable*>(Obj)->RowStruct;
+            if (!RowStruct || RowStruct->GetName() != "CellExchangeTableData") continue;
+            s_table = Obj;
+            break;
+        }
+        if (!s_table) return;
+    }
+
+    int Rows = 0, Changed = 0;
+    std::string Before;
+    for (auto& Pair : static_cast<SDK::UDataTable*>(s_table)->RowMap) {
+        uint8_t* Row = Pair.Value();
+        if (!Row) continue;
+        ++Rows;
+        int64_t& Ticks = *reinterpret_cast<int64_t*>(&reinterpret_cast<SDK::FCellExchangeTableData*>(Row)->TimeRequired);
+        if (Ticks == s_ticks) continue;
+        if (Changed < 8) Before += (Before.empty() ? "" : ",") + Pair.Key().GetRawString() + "(" + std::to_string(Ticks / 600000000LL) + "min)";
+        Ticks = s_ticks;
+        ++Changed;
+    }
+    if (Changed > 0) {
+        MpLog("[CellFusion] set " + std::to_string(Changed) + "/" + std::to_string(Rows) + " fusion recipe(s) of "
+            + s_table->GetName() + " to " + std::to_string(s_ticks / 600000000LL) + " min; before: " + Before);
+    }
+}
